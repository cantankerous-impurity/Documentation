Cell[BoxData[{
 RowBox[{
  RowBox[{
  "Print", "[", 
   "\"\<Are the MatrixRepresentationOfTdOperators consistent with the Td \
multiplication table?\>\"", "]"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"Apply", "[", 
   RowBox[{"Print", ",", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"Table", "[", "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{"\"\<   \>\"", "<>", 
          RowBox[{"ToString", "[", "r", "]"}], "<>", "\"\<: \>\""}], ",", 
         "\[IndentingNewLine]", 
         RowBox[{"AllTrue", "[", 
          RowBox[{
           RowBox[{
            RowBox[{"Table", "[", 
             RowBox[{
              RowBox[{
               RowBox[{
                RowBox[{
                 RowBox[{"(", 
                  RowBox[{"MatrixRepresentationOfTdOperators", "[", 
                   RowBox[{"[", 
                    RowBox[{"r", ",", "P"}], "]"}], "]"}], ")"}], ".", 
                 RowBox[{"(", 
                  RowBox[{"MatrixRepresentationOfTdOperators", "[", 
                   RowBox[{"[", 
                    RowBox[{"r", ",", "Q"}], "]"}], "]"}], ")"}]}], 
                "\[Equal]", 
                RowBox[{"(", 
                 RowBox[{"MatrixRepresentationOfTdOperators", "[", 
                  RowBox[{"[", 
                   RowBox[{"r", ",", 
                    RowBox[{"MultiplicationTableByIndex", "[", 
                    RowBox[{"[", 
                    RowBox[{"P", ",", "Q"}], "]"}], "]"}]}], "]"}], "]"}], 
                 ")"}]}], "//", "FullSimplify"}], ",", 
              RowBox[{"{", 
               RowBox[{"P", ",", "1", ",", "24"}], "}"}], ",", 
              RowBox[{"{", 
               RowBox[{"Q", ",", "1", ",", "24"}], "}"}]}], "]"}], "//", 
            "Flatten"}], ",", 
           RowBox[{"#", "&"}]}], "]"}]}], "}"}], "\[IndentingNewLine]", ",", 
       RowBox[{"{", 
        RowBox[{"r", ",", "1", ",", "5"}], "}"}]}], "]"}], "//", 
     "Flatten"}]}], "\[IndentingNewLine]", "]"}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"Print", "[", "\[IndentingNewLine]", 
   RowBox[{
   "\"\<Does the MatrixRepresentationOfTdOperators have the correct character \
table?\\n   \>\"", ",", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"Table", "[", 
      RowBox[{
       RowBox[{"Total", "[", 
        RowBox[{"Diagonal", "[", 
         RowBox[{"MatrixRepresentationOfTdOperators", "[", 
          RowBox[{"[", 
           RowBox[{"repr", ",", "opr"}], "]"}], "]"}], "]"}], "]"}], ",", 
       RowBox[{"{", 
        RowBox[{"repr", ",", "1", ",", "5"}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"opr", ",", "1", ",", "24"}], "}"}]}], "]"}], "==", 
     "CharactersForTdOperators"}]}], "\[IndentingNewLine]", "]"}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"Print", "[", "\[IndentingNewLine]", 
   RowBox[{
   "\"\<Does the MatrixRepresentationOfTdOperators obey the great \
orthogonality theorem?\\n   \>\"", ",", "\[IndentingNewLine]", 
    RowBox[{"AllTrue", "[", 
     RowBox[{
      RowBox[{
       RowBox[{"Table", "[", "\[IndentingNewLine]", 
        RowBox[{
         RowBox[{
          RowBox[{
           RowBox[{"Sum", "[", "  ", 
            RowBox[{
             RowBox[{
              RowBox[{"Conjugate", "[", 
               RowBox[{
                RowBox[{"MatrixRepresentationOfTdOperators", "[", 
                 RowBox[{"[", 
                  RowBox[{"i", ",", "R"}], "]"}], "]"}], "[", 
                RowBox[{"[", 
                 RowBox[{"\[Mu]", ",", "\[Nu]"}], "]"}], "]"}], "]"}], 
              RowBox[{
               RowBox[{"MatrixRepresentationOfTdOperators", "[", 
                RowBox[{"[", 
                 RowBox[{"j", ",", "R"}], "]"}], "]"}], "[", 
               RowBox[{"[", 
                RowBox[{"\[Alpha]", ",", "\[Beta]"}], "]"}], "]"}]}], "  ", 
             ",", 
             RowBox[{"{", 
              RowBox[{"R", ",", "1", ",", "24"}], "}"}]}], "]"}], 
           "\[IndentingNewLine]", "\[Equal]", 
           RowBox[{
            FractionBox["24", 
             RowBox[{"CharactersForTdOperators", "[", 
              RowBox[{"[", 
               RowBox[{"i", ",", "1"}], "]"}], "]"}]], 
            TemplateBox[{
              RowBox[{"i", ",", "j"}]},
             "KroneckerDeltaSeq"], 
            TemplateBox[{
              RowBox[{"\[Mu]", ",", "\[Alpha]"}]},
             "KroneckerDeltaSeq"], 
            TemplateBox[{
              RowBox[{"\[Nu]", ",", "\[Beta]"}]},
             "KroneckerDeltaSeq"]}]}], "//", "FullSimplify"}], 
         "\[IndentingNewLine]", ",", 
         RowBox[{"{", 
          RowBox[{"i", ",", "1", ",", "5"}], "}"}], ",", 
         RowBox[{"{", 
          RowBox[{"j", ",", "1", ",", "5"}], "}"}], ",", 
         RowBox[{"{", 
          RowBox[{"\[Mu]", ",", "1", ",", 
           RowBox[{"CharactersForTdOperators", "[", 
            RowBox[{"[", 
             RowBox[{"i", ",", "1"}], "]"}], "]"}]}], "}"}], ",", 
         RowBox[{"{", 
          RowBox[{"\[Nu]", ",", "1", ",", 
           RowBox[{"CharactersForTdOperators", "[", 
            RowBox[{"[", 
             RowBox[{"i", ",", "1"}], "]"}], "]"}]}], "}"}], ",", 
