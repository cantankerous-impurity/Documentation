Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"matGen", "[", 
    RowBox[{
    "s_", ",", "v_", ",", "\[ScriptCapitalS]_", ",", "\[CapitalOmega]_", ",", 
     "\[Kappa]0_", ",", "\[Kappa]1_", ",", "d_", ",", "\[GothicCapitalU]_", 
     ",", "W_", ",", "Basis_"}], "]"}], ":=", "\[IndentingNewLine]", 
   RowBox[{"Block", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"M", ",", 
       RowBox[{"BasisSize", "=", 
        RowBox[{"Basis", "//", "Length"}]}], ",", "m0", ",", "l0", ",", "k0", 
       ",", "\[Eta]0", ",", "\[Lambda]0", ",", "\[Omega]0", ",", "\[Sigma]0", 
       ",", "m1", ",", "l1", ",", "k1", ",", "\[Eta]1", ",", "\[Lambda]1", 
       ",", "\[Omega]1", ",", "\[Sigma]1", ",", "Cc"}], "}"}], ",", 
     "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"M", "=", 
       RowBox[{"ConstantArray", "[", 
        RowBox[{"0", ",", 
         RowBox[{"{", 
          RowBox[{"BasisSize", ",", "BasisSize"}], "}"}]}], "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"Do", "[", "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{
         RowBox[{
          RowBox[{"{", 
           RowBox[{
           "m0", ",", "l0", ",", "k0", ",", "\[Eta]0", ",", "\[Lambda]0", ",",
             "\[Omega]0", ",", "\[Sigma]0"}], "}"}], "=", 
          RowBox[{"Basis", "[", 
           RowBox[{"[", "m", "]"}], "]"}]}], ";", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{
           "m1", ",", "l1", ",", "k1", ",", "\[Eta]1", ",", "\[Lambda]1", ",",
             "\[Omega]1", ",", "\[Sigma]1"}], "}"}], "=", 
          RowBox[{"Basis", "[", 
           RowBox[{"[", "n", "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
         RowBox[{"If", "[", 
          RowBox[{
           RowBox[{
            RowBox[{"\[Omega]0", " ", "!=", "1"}], "&&", 
            RowBox[{"s", "==", "\"\<yx\>\""}]}], ",", 
           RowBox[{
            RowBox[{
             RowBox[{"M", "[", 
              RowBox[{"[", 
               RowBox[{"m", ",", "n"}], "]"}], "]"}], "=", "0"}], ";", 
            RowBox[{"Continue", "[", "]"}]}]}], "]"}], ";", 
         "\[IndentingNewLine]", 
         RowBox[{
          RowBox[{"M", "[", 
           RowBox[{"[", 
            RowBox[{"m", ",", "n"}], "]"}], "]"}], "=", 
          RowBox[{"NIntegrate", "[", 
           RowBox[{
            RowBox[{"\[ScriptCapitalI]Bloch", "[", 
             RowBox[{
             "W", ",", "s", ",", "v", ",", "\[ScriptCapitalS]", ",", 
              "\[Gamma]Si", ",", "\[Kappa]0", ",", "\[Kappa]1", ",", "d", ",",
               "\[GothicCapitalU]", ",", "\[Eta]0", ",", "\[Lambda]0", ",", 
              "\[Omega]0", ",", "\[Sigma]0", ",", "m0", ",", "l0", ",", "k0", 
              ",", "\[Eta]1", ",", "\[Lambda]1", ",", "\[Omega]1", ",", 
              "\[Sigma]1", ",", "m1", ",", "l1", ",", "k1", ",", "\[Chi]", 
              ",", "\[Phi]"}], "]"}], ",", 
            RowBox[{"{", 
             RowBox[{"\[Chi]", ",", 
              RowBox[{"-", "1"}], ",", 
              RowBox[{"+", "1"}]}], "}"}], ",", 
            RowBox[{"{", 
             RowBox[{"\[Phi]", ",", 
              RowBox[{"-", "\[Pi]"}], ",", 
              RowBox[{"+", "\[Pi]"}]}], "}"}], ",", 
            RowBox[{"AccuracyGoal", "\[Rule]", 
             RowBox[{"(", 
              RowBox[{"MachinePrecision", "-", "3"}], ")"}]}], ",", 
            RowBox[{"PrecisionGoal", "\[Rule]", 
             RowBox[{"(", 
              RowBox[{"MachinePrecision", "-", "3"}], ")"}]}], ",", 
            RowBox[{"MinRecursion", "->", "10"}], ",", 
            RowBox[{"MaxRecursion", "->", "160"}], ",", 
            RowBox[{"Method", "\[Rule]", 
             RowBox[{"{", 
              RowBox[{"GlobalAdaptive", ",", 
