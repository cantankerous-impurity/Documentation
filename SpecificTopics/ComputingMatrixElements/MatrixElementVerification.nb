              SuperscriptBox["\[ImaginaryI]", "m0"], 
              SuperscriptBox[
               RowBox[{"(", 
                RowBox[{"-", "1"}], ")"}], "l0"]}]}], ";"}]}], "]"}], ";", 
         "\[IndentingNewLine]", 
         RowBox[{"If", "[", 
          RowBox[{
           RowBox[{"s", "==", "\"\<yx\>\""}], ",", 
           RowBox[{"If", "[", 
            RowBox[{
             RowBox[{"\[Omega]0", " ", "==", "1"}], ",", 
             RowBox[{"Cc", "*=", "2"}], ",", 
             RowBox[{"Cc", "*=", "0"}]}], "]"}]}], "]"}], ";", 
         "\[IndentingNewLine]", 
         RowBox[{
          RowBox[{"M", "[", 
           RowBox[{"[", 
            RowBox[{"m", ",", "n"}], "]"}], "]"}], "*=", "Cc"}]}], 
        "\[IndentingNewLine]", ",", 
        RowBox[{"{", 
         RowBox[{"m", ",", "1", ",", "BasisSize"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"n", ",", 
          RowBox[{"m", "+", "1"}], ",", "BasisSize"}], "}"}]}], "]"}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"M", "+=", 
       RowBox[{"ConjugateTranspose", "[", "M", "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"Do", "[", "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{
         RowBox[{
          RowBox[{"{", 
           RowBox[{
           "m1", ",", "l1", ",", "k1", ",", "\[Eta]1", ",", "\[Lambda]1", ",",
             "\[Omega]1", ",", "\[Sigma]1"}], "}"}], "=", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{
            "m0", ",", "l0", ",", "k0", ",", "\[Eta]0", ",", "\[Lambda]0", 
             ",", "\[Omega]0", ",", "\[Sigma]0"}], "}"}], "=", 
           RowBox[{"Basis", "[", 
            RowBox[{"[", "m", "]"}], "]"}]}]}], ";", "\[IndentingNewLine]", 
         RowBox[{
          RowBox[{"M", "[", 
           RowBox[{"[", 
            RowBox[{"m", ",", "m"}], "]"}], "]"}], "=", 
          RowBox[{"NIntegrate", "[", 
           RowBox[{
            RowBox[{"\[ScriptCapitalI]Bloch", "[", 
             RowBox[{
             "W", ",", "s", ",", "v", ",", "\[ScriptCapitalS]", ",", 
              "\[Gamma]Si", ",", "\[Kappa]0", ",", "\[Kappa]1", ",", "d", ",",
               "\[GothicCapitalU]", ",", "\[Eta]0", ",", "\[Lambda]0", ",", 
              "\[Omega]0", ",", "\[Sigma]0", ",", "m0", ",", "l0", ",", "k0", 
              ",", "\[Eta]1", ",", "\[Lambda]1", ",", "\[Omega]1", ",", 
              "\[Sigma]1", ",", "m1", ",", "l1", ",", "k1", ",", "\[Chi]", 
              ",", "\[Phi]"}], "]"}], ",", 
            RowBox[{"{", 
             RowBox[{"\[Chi]", ",", 
              RowBox[{"-", "1"}], ",", 
              RowBox[{"+", "1"}]}], "}"}], ",", 
            RowBox[{"{", 
             RowBox[{"\[Phi]", ",", 
              RowBox[{"-", "\[Pi]"}], ",", 
              RowBox[{"+", "\[Pi]"}]}], "}"}], ",", 
            RowBox[{"AccuracyGoal", "\[Rule]", 
             RowBox[{"(", 
              RowBox[{"MachinePrecision", "-", "3"}], ")"}]}], ",", 
            RowBox[{"PrecisionGoal", "\[Rule]", 
             RowBox[{"(", 
              RowBox[{"MachinePrecision", "-", "3"}], ")"}]}], ",", 
            RowBox[{"MinRecursion", "->", "10"}], ",", 
            RowBox[{"MaxRecursion", "->", "160"}], ",", 
            RowBox[{"Method", "\[Rule]", 
             RowBox[{"{", 
              RowBox[{"GlobalAdaptive", ",", 
               RowBox[{"MaxErrorIncreases", "\[Rule]", "16000"}]}], "}"}]}]}],
            "]"}]}], ";", "\[IndentingNewLine]", 
         RowBox[{"Cc", "=", "1"}], ";", "\[IndentingNewLine]", 
         RowBox[{"If", "[", 
          RowBox[{"\[CapitalOmega]", ",", 
           RowBox[{
            RowBox[{"Cc", "*=", 
             RowBox[{"\[Omega]0", " ", "\[Sigma]0", " ", 
              SuperscriptBox["\[ImaginaryI]", "m0"], 
              SuperscriptBox[
               RowBox[{"(", 
                RowBox[{"-", "1"}], ")"}], "l0"]}]}], ";"}]}], "]"}], ";", 
         "\[IndentingNewLine]", 
         RowBox[{"If", "[", 
          RowBox[{
