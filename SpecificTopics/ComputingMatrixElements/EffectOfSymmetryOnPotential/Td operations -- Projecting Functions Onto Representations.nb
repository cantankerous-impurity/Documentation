                    RowBox[{"r", ",", "1"}], "]"}], "]"}]], 
                 RowBox[{
                  RowBox[{"P1", "[", 
                   RowBox[{"r", ",", "\[Lambda]", ",", "\[Kappa]"}], "]"}], 
