      RowBox[{"Do", "[", "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{
         RowBox[{"Print", "[", 
          RowBox[{
          "\[Lambda]", ",", "\"\< \>\"", ",", "\[Kappa]", ",", "\"\<    \>\"",
            ",", 
           RowBox[{
            FractionBox[
             RowBox[{"CharactersForTdOperators", "[", 
              RowBox[{"[", 
               RowBox[{"r", ",", "1"}], "]"}], "]"}], "24"], 
            RowBox[{"(", 
             RowBox[{
              RowBox[{"(", 
               RowBox[{
                RowBox[{
                 FractionBox["24", 
                  RowBox[{"CharactersForTdOperators", "[", 
