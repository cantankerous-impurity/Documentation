                    RowBox[{"Sin", "[", "\[Phi]", "]"}]}]}], ",", 
                    RowBox[{"z", "->", "\[Chi]"}]}], "}"}]}], "//", 
                  "Simplify"}], ")"}], "\[IndentingNewLine]", "/.", 
                RowBox[{"{", 
                 RowBox[{
                  RowBox[{
                   RowBox[{"Cos", "[", 
                    RowBox[{"2", "\[Phi]"}], "]"}], "->", 
                   FractionBox[
                    RowBox[{
                    SuperscriptBox["x", "2"], "-", 
                    SuperscriptBox["y", "2"]}], 
                    RowBox[{"1", "-", 
                    SuperscriptBox["\[Chi]", "2"]}]]}], ",", 
                  RowBox[{
                   RowBox[{"Cos", "[", "\[Phi]", "]"}], "->", 
                   FractionBox["x", 
                    SqrtBox[
                    RowBox[{"1", "-", 
                    SuperscriptBox["\[Chi]", "2"]}]]]}], ",", 
                  RowBox[{
                   RowBox[{"Sin", "[", "\[Phi]", "]"}], "->", 
