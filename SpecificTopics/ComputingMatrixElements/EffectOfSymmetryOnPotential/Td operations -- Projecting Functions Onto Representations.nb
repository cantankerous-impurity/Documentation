                    RowBox[{
                    SubscriptBox["c", "\"\<xy\>\""], "x", " ", "y"}], "+", 
                    RowBox[{
                    SubscriptBox["c", "\"\<xz\>\""], "x", " ", "z"}], "+", 
                    RowBox[{
                    SubscriptBox["c", "\"\<yy\>\""], 
                    SuperscriptBox["y", "2"]}], "+", 
                    RowBox[{
                    SubscriptBox["c", "\"\<yz\>\""], "y", " ", "z"}], "+", 
                    RowBox[{
                    SubscriptBox["c", "\"\<zz\>\""], 
                    SuperscriptBox["z", "2"]}]}]}], "]"}]}], "]"}], 
                   "\[IndentingNewLine]", "/.", 
                   RowBox[{"{", 
                    RowBox[{
                    RowBox[{"x", "->", 
                    RowBox[{
                    SqrtBox[
                    RowBox[{"1", "-", 
