Cell[BoxData[{
 RowBox[{
  RowBox[{"Print", "[", 
   RowBox[{
   "\"\<Do the Q0 projection operators act as mutually orthogonal projection \
operators?\\n   \>\"", ",", "\[IndentingNewLine]", 
    RowBox[{"AllTrue", "[", 
     RowBox[{
      RowBox[{
       RowBox[{"Table", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{
           RowBox[{
            RowBox[{"Q0", "[", "r", "]"}], "\[Equal]", 
            RowBox[{
             RowBox[{"Q0", "[", "r", "]"}], ".", 
             RowBox[{"Q0", "[", "r", "]"}]}]}], ",", 
           RowBox[{"Table", "[", 
            RowBox[{
             RowBox[{
              RowBox[{
               RowBox[{"Q0", "[", "r1", "]"}], ".", 
               RowBox[{"Q0", "[", "r", "]"}]}], "\[Equal]", 
              RowBox[{"ConstantArray", "[", 
               RowBox[{"0", ",", 
                RowBox[{"{", 
                 RowBox[{"24", ",", "24"}], "}"}]}], "]"}]}], ",", 
             RowBox[{"{", 
              RowBox[{"r1", ",", "1", ",", 
               RowBox[{"r", "-", "1"}]}], "}"}]}], "]"}], ",", 
           RowBox[{"Table", "[", 
            RowBox[{
             RowBox[{
              RowBox[{
               RowBox[{"Q0", "[", "r1", "]"}], ".", 
               RowBox[{"Q0", "[", "r", "]"}]}], "\[Equal]", 
              RowBox[{"ConstantArray", "[", 
               RowBox[{"0", ",", 
                RowBox[{"{", 
                 RowBox[{"24", ",", "24"}], "}"}]}], "]"}]}], ",", 
             RowBox[{"{", 
              RowBox[{"r1", ",", 
               RowBox[{"r", "+", "1"}], ",", "5"}], "}"}]}], "]"}]}], "}"}], 
         ",", 
         RowBox[{"{", 
          RowBox[{"r", ",", "1", ",", "5"}], "}"}]}], "]"}], "//", 
       "Flatten"}], ",", 
      RowBox[{"#", "&"}]}], "]"}]}], "\[IndentingNewLine]", "]"}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"Print", "[", 
   RowBox[{
   "\"\<Is the sum of the Q0 projection operators identity?\\n   \>\"", ",", 
