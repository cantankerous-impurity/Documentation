            RowBox[{"[", "opr", "]"}], "]"}], 
           RowBox[{"ListOfPrefactorTdOperators", "[", 
            RowBox[{"[", "opr", "]"}], "]"}]}], ",", 
          RowBox[{"{", 
           RowBox[{"opr", ",", "1", ",", "24"}], "}"}]}], "]"}], "//", 
