Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{
   "A", " ", "prefactor", " ", "representation", " ", "of", " ", "the", " ", 
    "operators", " ", "used", " ", "to", " ", "project", " ", "functions", 
    " ", "upon", " ", "rows", " ", "of", " ", "our", " ", "chosen", " ", 
    "irreducible", " ", 
    RowBox[{"representation", "."}]}], " ", "*)"}], "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"PrefactorsForAllProjections", "=", 
     RowBox[{"Table", "[", "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{
        FractionBox[
         RowBox[{"CharactersForTdOperators", "[", 
          RowBox[{"[", 
           RowBox[{"r", ",", "1"}], "]"}], "]"}], "24"], 
        RowBox[{"Table", "[", 
         RowBox[{
          RowBox[{"Conjugate", "[", 
           RowBox[{
            RowBox[{"MatrixRepresentationOfTdOperators", "[", 
             RowBox[{"[", 
              RowBox[{"r", ",", "o"}], "]"}], "]"}], "[", 
            RowBox[{"[", 
             RowBox[{"\[Lambda]", ",", "\[Kappa]"}], "]"}], "]"}], "]"}], ",", 
          RowBox[{"{", 
           RowBox[{"o", ",", "1", ",", "24"}], "}"}]}], "]"}]}], 
       "\[IndentingNewLine]", ",", 
       RowBox[{"{", 
        RowBox[{"r", ",", "1", ",", "5"}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"\[Lambda]", ",", "1", ",", 
         RowBox[{"CharactersForTdOperators", "[", 
          RowBox[{"[", 
           RowBox[{"r", ",", "1"}], "]"}], "]"}]}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"\[Kappa]", ",", "1", ",", 
         RowBox[{"CharactersForTdOperators", "[", 
          RowBox[{"[", 
           RowBox[{"r", ",", "1"}], "]"}], "]"}]}], "}"}]}], "]"}]}], ";"}], 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"Clear", "[", "P1", "]"}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"Do", "[", 
     RowBox[{
      RowBox[{
       RowBox[{"P1", "[", 
        RowBox[{"r", ",", "\[Lambda]", ",", "\[Kappa]"}], "]"}], "=", 
