           RowBox[{"\[Gamma]1", "->", "0.0000"}], ",", 
           RowBox[{"\[Gamma]2", "->", "2.044"}]}], "}"}], ",", 
         "\[IndentingNewLine]", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{"\[Eta]", "->", "10.8"}], ",", 
           RowBox[{"A", "->", "0.8918"}], ",", 
           RowBox[{"\[Gamma]0", "->", "0.9743"}], ",", 
           RowBox[{"\[Gamma]1", "->", "0.1586"}], ",", 
           RowBox[{"\[Gamma]2", "->", "0.1586"}]}], "}"}]}], 
        "\[IndentingNewLine]", "}"}], ",", "prec"}], "]"}]}], ";", 
    "\[IndentingNewLine]", 
    RowBox[{"rule", "=", 
     RowBox[{"rules", "[", 
      RowBox[{"[", "4", "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
    "\[IndentingNewLine]", 
    RowBox[{"f", "=", 
     RowBox[{
      RowBox[{
       FractionBox["2", "r"], 
       RowBox[{"Sum", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"Sum", "[", 
           RowBox[{
            RowBox[{
             SuperscriptBox["2", 
              RowBox[{"n", "-", "i"}]], 
             FractionBox[
              RowBox[{"Gamma", "[", 
               RowBox[{
                RowBox[{"Mod", "[", 
                 RowBox[{"n", ",", "2"}], "]"}], "+", 
                FractionBox["1", "2"], "+", 
                RowBox[{"Quotient", "[", 
                 RowBox[{"n", ",", "2"}], "]"}]}], "]"}], 
              RowBox[{"Gamma", "[", 
               RowBox[{
                RowBox[{"Mod", "[", 
                 RowBox[{"n", ",", "2"}], "]"}], "+", 
                FractionBox["1", "2"], "+", 
                RowBox[{"Quotient", "[", 
                 RowBox[{"i", ",", "2"}], "]"}]}], "]"}]], 
             RowBox[{"Binomial", "[", 
              RowBox[{
               RowBox[{"Quotient", "[", 
                RowBox[{"n", ",", "2"}], "]"}], ",", 
               RowBox[{"Quotient", "[", 
                RowBox[{"i", ",", "2"}], "]"}]}], "]"}], 
             RowBox[{"(", 
              RowBox[{
               RowBox[{"D", "[", 
                RowBox[{
                 RowBox[{"\[ScriptK]", "[", 
                  RowBox[{
                   FractionBox[
                    RowBox[{"2", 
                    RowBox[{"\[ScriptK]", "[", "0", "]"}]}], 
                    RowBox[{"\[Beta]", " ", "Uc", 
                    SqrtBox["\[ScriptCapitalN]"]}]], "\[ScriptR]"}], "]"}], 
                 ",", 
                 RowBox[{"{", 
                  RowBox[{"\[ScriptR]", ",", "i"}], "}"}]}], "]"}], "/.", 
               RowBox[{"\[ScriptR]", "->", "0"}]}], ")"}]}], ",", 
            RowBox[{"{", 
             RowBox[{"i", ",", 
              RowBox[{"Mod", "[", 
               RowBox[{"n", ",", "2"}], "]"}], ",", "n", ",", "2"}], "}"}]}], 
           "]"}], 
          FractionBox[
           SuperscriptBox[
            RowBox[{"(", 
             RowBox[{
              FractionBox[
               RowBox[{"\[Beta]", " ", "Uc", 
                SqrtBox["\[ScriptCapitalN]"]}], 
               RowBox[{"2", 
                RowBox[{"\[ScriptK]", "[", "0", "]"}]}]], "r"}], ")"}], "n"], 
           RowBox[{"n", "!"}]]}], ",", 
         RowBox[{"{", 
          RowBox[{"n", ",", "0", ",", 
           RowBox[{"\[ScriptCapitalN]", "-", "1"}]}], "}"}]}], "]"}]}], "-", 
      RowBox[{"Uc", " ", 
       RowBox[{"Sum", "[", 
        RowBox[{
         FractionBox[
          SuperscriptBox[
           RowBox[{"(", 
            RowBox[{
             FractionBox[
              RowBox[{"\[Beta]", " ", "Uc", 
               SqrtBox["\[ScriptCapitalN]"]}], 
              RowBox[{"2", 
               RowBox[{"\[ScriptK]", "[", "0", "]"}]}]], " ", "r"}], ")"}], 
           RowBox[{"2", "m"}]], 
          RowBox[{"m", "!"}]], ",", 
         RowBox[{"{", 
          RowBox[{"m", ",", "0", ",", 
           RowBox[{"Quotient", "[", 
            RowBox[{"\[ScriptCapitalN]", ",", "2"}], "]"}]}], "}"}]}], 
        "]"}]}]}]}], ";", "\[IndentingNewLine]", 
    RowBox[{"g", "=", 
     RowBox[{
      RowBox[{
       RowBox[{"-", 
        FractionBox["2", "r"]}], 
       RowBox[{"\[ScriptK]", "[", "r", "]"}]}], "+", 
      RowBox[{
       RowBox[{"Exp", "[", 
        RowBox[{"-", 
         SuperscriptBox[
          RowBox[{"(", 
           RowBox[{
            FractionBox[
             RowBox[{"\[Beta]", " ", "Uc", 
              SqrtBox["\[ScriptCapitalN]"]}], 
             RowBox[{"2", 
              RowBox[{"\[ScriptK]", "[", "0", "]"}]}]], "r"}], ")"}], "2"]}], 
        "]"}], "f"}]}]}], ";", "\[IndentingNewLine]", "\[IndentingNewLine]", 
    RowBox[{"s", "=", 
     RowBox[{"Collect", "[", 
      RowBox[{
       RowBox[{"Series", "[", 
        RowBox[{"g", ",", 
         RowBox[{"{", 
          RowBox[{"r", ",", "0", ",", "\[ScriptCapitalN]"}], "}"}]}], "]"}], 
       ",", "r", ",", "Together"}], "]"}]}], ";", "\[IndentingNewLine]", 
    RowBox[{"eqn", "=", 
     RowBox[{"Assuming", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{"Uc", ">", "0"}], ",", 
         RowBox[{
          RowBox[{"\[ScriptK]", "[", "0", "]"}], ">", "0"}]}], "}"}], ",", 
       "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{
         RowBox[{"D", "[", 
          RowBox[{"s", ",", 
           RowBox[{"{", 
            RowBox[{"r", ",", 
             RowBox[{"\[ScriptCapitalN]", "-", "1"}]}], "}"}]}], "]"}], "/.", 
         RowBox[{"r", "->", "0"}]}], "//", "FullSimplify"}]}], 
      "\[IndentingNewLine]", "]"}]}], ";", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"\[ScriptK]", "[", "r_", "]"}], "=", 
     RowBox[{
      RowBox[{"1", "+", 
       RowBox[{"A", " ", "\[Eta]", " ", 
        RowBox[{"Exp", "[", 
         RowBox[{
          RowBox[{"-", "\[Gamma]0"}], " ", "r"}], "]"}]}], "+", 
       RowBox[{
        RowBox[{"(", 
         RowBox[{"1", "-", "A"}], ")"}], "\[Eta]", " ", 
        RowBox[{"Exp", "[", 
         RowBox[{
          RowBox[{"-", "\[Gamma]1"}], " ", "r"}], "]"}]}], "-", 
       RowBox[{"Exp", "[", 
        RowBox[{
         RowBox[{"-", "\[Gamma]2"}], " ", "r"}], "]"}]}], "/.", "rule"}]}], 
    ";", "\[IndentingNewLine]", 
    RowBox[{"\[Beta]", "=", 
     RowBox[{"SetPrecision", "[", 
      RowBox[{".8", ",", "prec"}], "]"}]}], ";", "\[IndentingNewLine]", 
    "\[IndentingNewLine]", 
    RowBox[{"Off", "[", 
     RowBox[{"General", "::", "munfl"}], "]"}], ";", "\[IndentingNewLine]", 
    RowBox[{"plt", "=", 
     RowBox[{"Plot", "[", "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"{", "\[IndentingNewLine]", 
        RowBox[{
         RowBox[{"Style", "[", 
          RowBox[{
           RowBox[{"-", "Uc"}], ",", "Dashed", ",", 
           RowBox[{"Thickness", "[", "Medium", "]"}], ",", "Red"}], "]"}], 
         ",", 
         RowBox[{"Style", "[", 
          RowBox[{
           RowBox[{"-", 
            FractionBox["2", "r"]}], ",", "DotDashed", ",", 
           RowBox[{"Thickness", "[", "Medium", "]"}], ",", 
           RowBox[{"Darker", "[", "Green", "]"}]}], "]"}], ",", 
         RowBox[{"Style", "[", 
          RowBox[{
           RowBox[{
            RowBox[{"-", 
             FractionBox["2", "r"]}], 
            RowBox[{"\[ScriptK]", "[", "0", "]"}]}], ",", "DotDashed", ",", 
           RowBox[{"Thickness", "[", "Medium", "]"}], ",", "Blue"}], "]"}], 
         "\[IndentingNewLine]", ",", 
         RowBox[{"Style", "[", 
          RowBox[{"g", ",", "Purple"}], "]"}], ",", 
         RowBox[{"Style", "[", 
          RowBox[{
           RowBox[{
            RowBox[{"-", 
             FractionBox["2", "r"]}], 
            RowBox[{"\[ScriptK]", "[", "r", "]"}]}], ",", "Orange", ",", 
           RowBox[{"Thickness", "[", "Large", "]"}]}], "]"}]}], 
        "\[IndentingNewLine]", "}"}], "\[IndentingNewLine]", ",", 
       RowBox[{"{", 
        RowBox[{"r", ",", "0", ",", "1"}], "}"}], "\[IndentingNewLine]", ",", 
       RowBox[{"WorkingPrecision", "\[Rule]", 
        RowBox[{"prec", "-", "10"}]}], ",", 
       RowBox[{"PerformanceGoal", "\[Rule]", "\"\<Quality\>\""}], ",", 
       RowBox[{"ImageSize", "\[Rule]", "Large"}], "\[IndentingNewLine]", ",", 
       RowBox[{"PlotRange", "->", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{
           RowBox[{"(", 
            RowBox[{
             RowBox[{"-", "1"}], "-", "\[CapitalDelta]"}], ")"}], "Uc"}], ",",
           "0"}], "}"}]}]}], "]"}]}], ";", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"Labeled", "[", 
      RowBox[{"plt", ",", 
       RowBox[{"{", 
        RowBox[{
         FractionBox["r", 
          SubscriptBox["r", "AU"]], ",", 
         "\"\<\!\(\*FractionBox[\(E\), SubscriptBox[\(E\), \(AU\)]]\)\>\"", 
         ",", 
         RowBox[{"\"\<\[ScriptCapitalN] = \>\"", "<>", 
          RowBox[{"ToString", "[", "\[ScriptCapitalN]", "]"}]}]}], "}"}], ",", 
       RowBox[{"{", 
