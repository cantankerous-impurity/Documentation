                FractionBox["\[ScriptCapitalN]", "2"]}], "]"}], "+", 
              FractionBox["2", "r"]}], 
             RowBox[{"Exp", "[", 
              RowBox[{
               RowBox[{"-", 
                FractionBox["\[ScriptCapitalN]", "2"]}], " ", "U0", " ", 
               "r"}], "]"}]], ",", "r"}], "]"}], 
          RowBox[{"Exp", "[", 
           RowBox[{
            RowBox[{"-", 
             FractionBox["\[ScriptCapitalN]", "2"]}], " ", "U0", " ", "r"}], 
           "]"}]}], "-", 
         FractionBox["2", "r"]}]}], ")"}], "//", "Print"}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{
       RowBox[{"gexp", "^", "2"}], "//", "Expand"}], "//", "Print"}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"Labeled", "[", 
       RowBox[{
        RowBox[{"plt", "[", "gexp", "]"}], ",", 
        RowBox[{"{", 
