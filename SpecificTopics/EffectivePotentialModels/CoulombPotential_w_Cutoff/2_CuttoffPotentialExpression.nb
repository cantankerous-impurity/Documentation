Cell[BoxData[{
 RowBox[{
  RowBox[{"Clear", "[", "g", "]"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"Block", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"g", ",", "\[ScriptCapitalN]", ",", "U0", ",", "prec"}], "}"}], 
    ",", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"prec", "=", "240"}], ";", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"g", "[", 
       RowBox[{"U0_", ",", "\[ScriptCapitalN]_", ",", "\[Alpha]_"}], "]"}], ":=", 
      RowBox[{
       RowBox[{"-", 
        FractionBox["2", "r"]}], 
       RowBox[{"(", 
        RowBox[{"1", "-", 
         RowBox[{
          FractionBox[
           RowBox[{"Exp", "[", 
            RowBox[{
             RowBox[{"-", "\[Alpha]"}], " ", "U0", " ", "r"}], "]"}], 
           RowBox[{"2", "\[Alpha]"}]], 
          RowBox[{"Sum", "[", 
           RowBox[{
            RowBox[{
             FractionBox[
              SuperscriptBox[
               RowBox[{"(", 
                RowBox[{"\[Alpha]", " ", "U0", " ", "r"}], ")"}], "n"], 
              RowBox[{"n", "!"}]], 
             RowBox[{"(", 
              RowBox[{
               RowBox[{"2", "\[Alpha]"}], "-", "n"}], ")"}]}], ",", 
            RowBox[{"{", 
             RowBox[{"n", ",", "0", ",", "\[ScriptCapitalN]"}], "}"}]}], 
           "]"}]}]}], ")"}]}]}], ";", 
     StyleBox["\[IndentingNewLine]",
      FontWeight->"Plain"], "\[IndentingNewLine]", 
     RowBox[{"U0", "=", "1"}], ";", 
     RowBox[{"\[ScriptCapitalN]", "=", "1"}], ";", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"plt", "[", "xp_", "]"}], ":=", 
      RowBox[{"Plot", "[", "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{
          RowBox[{"Style", "[", 
           RowBox[{
            RowBox[{"-", "U0"}], ",", "DotDashed"}], "]"}], ",", 
          RowBox[{"-", 
           FractionBox["2", "r"]}], ",", "xp"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"r", ",", "0", ",", 
          RowBox[{"20", 
           FractionBox["2", 
            RowBox[{"\[ScriptCapitalN]", " ", "U0"}]]}]}], "}"}], ",", 
        "\[IndentingNewLine]", 
        RowBox[{"PlotRange", "->", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{
            RowBox[{"-", "1.2"}], "*", "U0"}], ",", "0.05"}], "}"}]}], ",", 
        "\[IndentingNewLine]", 
        RowBox[{"WorkingPrecision", "\[Rule]", "prec"}], ",", 
        RowBox[{"PerformanceGoal", "\[Rule]", "\"\<Quality\>\""}], ",", 
        RowBox[{"ImageSize", "\[Rule]", "Large"}]}], "\[IndentingNewLine]", 
       "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"Off", "[", 
      RowBox[{"General", "::", "munfl"}], "]"}], ";", "\[IndentingNewLine]", 
