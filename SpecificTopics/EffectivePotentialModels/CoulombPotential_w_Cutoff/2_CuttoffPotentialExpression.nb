Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"Clear", "[", "g", "]"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"Block", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"g", ",", "\[ScriptCapitalN]", ",", "U0", ",", "prec"}], "}"}], 
    ",", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"prec", "=", "240"}], ";", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"f", "[", 
       RowBox[{"U0_", ",", "\[ScriptCapitalN]_", ",", "\[ScriptCapitalB]_"}], 
       "]"}], ":=", 
      RowBox[{
       RowBox[{
        RowBox[{"(", 
         RowBox[{"1", "-", 
          FractionBox[
           RowBox[{"U0", " ", "r"}], "2"]}], ")"}], 
        RowBox[{"(", 
         RowBox[{"Sum", "[", 
          RowBox[{
           FractionBox[
            SuperscriptBox[
             RowBox[{"(", 
              RowBox[{"\[ScriptCapitalB]", " ", "U0", " ", "r"}], ")"}], 
             RowBox[{"2", "n"}]], 
            RowBox[{"n", "!"}]], ",", 
           RowBox[{"{", 
            RowBox[{"n", ",", "0", ",", 
             RowBox[{"\[ScriptCapitalN]", "-", "1"}]}], "}"}]}], "]"}], 
         ")"}]}], "+", 
       FractionBox[
        SuperscriptBox[
         RowBox[{"(", 
          RowBox[{"\[ScriptCapitalB]", " ", "U0", " ", "r"}], ")"}], 
         RowBox[{"2", "\[ScriptCapitalN]"}]], 
        RowBox[{"\[ScriptCapitalN]", "!"}]]}]}], ";", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"g", "[", 
       RowBox[{"U0_", ",", "\[ScriptCapitalN]_", ",", "\[ScriptCapitalB]_"}], 
       "]"}], ":=", 
      RowBox[{
       RowBox[{"-", 
        FractionBox["2", "r"]}], 
       RowBox[{"(", 
        RowBox[{"1", "-", 
         RowBox[{
          RowBox[{"Exp", "[", 
           RowBox[{"-", 
            SuperscriptBox[
             RowBox[{"(", 
              RowBox[{"\[ScriptCapitalB]", " ", "U0", " ", "r"}], ")"}], 
             "2"]}], "]"}], 
          RowBox[{"f", "[", 
           RowBox[{"U0", ",", "\[ScriptCapitalN]", ",", "\[ScriptCapitalB]"}],
            "]"}]}]}], ")"}]}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"U0", "=", "3"}], ";", 
     RowBox[{"\[ScriptCapitalN]", "=", "2"}], ";", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"plt", "[", "xp_", "]"}], ":=", 
      RowBox[{"Plot", "[", "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{
          RowBox[{"Style", "[", 
           RowBox[{
            RowBox[{"-", "U0"}], ",", "DotDashed"}], "]"}], ",", 
          RowBox[{"-", 
           FractionBox["2", "r"]}], ",", "xp"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"r", ",", "0", ",", "10"}], "}"}], ",", 
        "\[IndentingNewLine]", 
        RowBox[{"PlotRange", "->", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{
            RowBox[{"-", "1.2"}], "*", "U0"}], ",", "0.05"}], "}"}]}], ",", 
        "\[IndentingNewLine]", 
        RowBox[{"WorkingPrecision", "\[Rule]", "prec"}], ",", 
        RowBox[{"PerformanceGoal", "\[Rule]", "\"\<Quality\>\""}], ",", 
        RowBox[{"ImageSize", "\[Rule]", "Large"}]}], "\[IndentingNewLine]", 
       "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"Off", "[", 
      RowBox[{"General", "::", "munfl"}], "]"}], ";", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"(", 
       RowBox[{"gexp", "=", 
        RowBox[{
         RowBox[{
          RowBox[{"Collect", "[", 
           RowBox[{
            FractionBox[
             RowBox[{
              RowBox[{"g", "[", 
               RowBox[{"U0", ",", "\[ScriptCapitalN]", ",", 
                FractionBox[
                 SqrtBox["\[ScriptCapitalN]"], "2"]}], "]"}], "+", 
              FractionBox["2", "r"]}], 
             RowBox[{"Exp", "[", 
              RowBox[{"-", 
               SuperscriptBox[
                RowBox[{"(", 
                 RowBox[{
                  FractionBox[
                   SqrtBox["\[ScriptCapitalN]"], "2"], " ", "U0", " ", "r"}], 
                 ")"}], "2"]}], "]"}]], ",", "r"}], "]"}], 
          RowBox[{"Exp", "[", 
           RowBox[{"-", 
            SuperscriptBox[
             RowBox[{"(", 
              RowBox[{
               FractionBox[
                SqrtBox["\[ScriptCapitalN]"], "2"], " ", "U0", " ", "r"}], 
              ")"}], "2"]}], "]"}]}], "-", 
         FractionBox["2", "r"]}]}], ")"}], "//", "Print"}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"Labeled", "[", 
       RowBox[{
        RowBox[{"plt", "[", "gexp", "]"}], ",", 
        RowBox[{"{", 
         RowBox[{
          FractionBox["r", 
           SubscriptBox["r", "AU"]], ",", 
          "\"\<\!\(\*FractionBox[\(E\), SubscriptBox[\(E\), \(AU\)]]\)\>\"", 
          ",", 
          RowBox[{"\"\<\[ScriptCapitalN] = \>\"", "<>", 
           RowBox[{"ToString", "[", "\[ScriptCapitalN]", "]"}]}]}], "}"}], 
        ",", 
        RowBox[{"{", 
         RowBox[{"Top", ",", "Left", ",", "Bottom"}], "}"}]}], "]"}], "//", 
      "Print"}], ";", "\[IndentingNewLine]", 
     RowBox[{"On", "[", 
      RowBox[{"General", "::", "munfl"}], "]"}], ";"}]}], 
   "\[IndentingNewLine]", "]"}], ";"}]}], "Input",
