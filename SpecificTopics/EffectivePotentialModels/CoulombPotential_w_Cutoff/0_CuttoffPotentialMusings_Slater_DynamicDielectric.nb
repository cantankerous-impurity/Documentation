     FractionBox[
      RowBox[{"3", " ", "r", " ", "Uc", " ", "\[Alpha]"}], 
      RowBox[{"2", " ", 
       RowBox[{"(", 
        RowBox[{
         RowBox[{
          RowBox[{"(", 
           RowBox[{"1", "-", "A"}], ")"}], " ", "\[Eta]"}], "+", 
         RowBox[{"A", " ", "\[Eta]"}]}], ")"}]}]]}]], " ", 
   RowBox[{"(", 
    RowBox[{
     RowBox[{"Uc", " ", 
      RowBox[{"(", 
       RowBox[{
        RowBox[{"-", "1"}], "+", 
        RowBox[{"3", " ", "\[Alpha]"}]}], ")"}]}], "+", 
     RowBox[{"2", " ", "\[Gamma]2"}], "+", 
     FractionBox[
      RowBox[{"2", " ", "\[Eta]"}], "r"], "-", 
     RowBox[{"2", " ", 
      RowBox[{"(", 
       RowBox[{
        RowBox[{"A", " ", "\[Gamma]0"}], "+", "\[Gamma]1", "-", 
        RowBox[{"A", " ", "\[Gamma]1"}]}], ")"}], " ", "\[Eta]"}], "+", 
     RowBox[{"r", " ", 
      RowBox[{"(", 
       RowBox[{
        RowBox[{
         RowBox[{"-", "3"}], " ", "Uc", " ", "\[Alpha]", " ", "\[Gamma]1"}], 
        "-", 
        SuperscriptBox["\[Gamma]2", "2"], "+", 
        FractionBox[
         RowBox[{"3", " ", "Uc", " ", "\[Alpha]", " ", 
