Cell[BoxData[
 RowBox[{"Block", "[", 
  RowBox[{
   RowBox[{"{", "\[IndentingNewLine]", 
    RowBox[{
    "prec", ",", "\[CapitalDelta]", ",", "\[IndentingNewLine]", 
     "\[ScriptCapitalN]", ",", "Uc", ",", "\[IndentingNewLine]", "\[ScriptK]",
      ",", "rules", ",", "rule", ",", "n", ",", "\[IndentingNewLine]", 
     "\[Alpha]", ",", "\[IndentingNewLine]", "f", ",", "g", ",", 
     "\[IndentingNewLine]", "s", ",", "eqn", ",", "soln", ",", 
     "\[IndentingNewLine]", "plt"}], "\[IndentingNewLine]", "}"}], ",", 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"prec", "=", "960"}], ";", "\[IndentingNewLine]", 
    RowBox[{"\[CapitalDelta]", "=", 
     RowBox[{"SetPrecision", "[", 
      RowBox[{".1", ",", "prec"}], "]"}]}], ";", "\[IndentingNewLine]", 
    "\[IndentingNewLine]", 
    RowBox[{"\[ScriptCapitalN]", "=", "3"}], ";", "\[IndentingNewLine]", 
    RowBox[{"Uc", "=", 
     RowBox[{"SetPrecision", "[", 
      RowBox[{"100.", ",", "prec"}], "]"}]}], ";", "\[IndentingNewLine]", 
    "\[IndentingNewLine]", "\[IndentingNewLine]", 
    RowBox[{"rules", "=", 
     RowBox[{"SetPrecision", "[", 
      RowBox[{
       RowBox[{"{", "\[IndentingNewLine]", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{
           RowBox[{"\[Eta]", "->", "11.4"}], ",", 
           RowBox[{"A", "->", "1.1750"}], ",", 
           RowBox[{"\[Gamma]0", "->", "0.7572"}], ",", 
           RowBox[{"\[Gamma]1", "->", "0.3223"}], ",", 
           RowBox[{"\[Gamma]2", "->", "2.044"}]}], "}"}], ",", 
         "\[IndentingNewLine]", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{"\[Eta]", "->", "10.8"}], ",", 
           RowBox[{"A", "->", "1.1750"}], ",", 
           RowBox[{"\[Gamma]0", "->", "0.7572"}], ",", 
           RowBox[{"\[Gamma]1", "->", "0.3223"}], ",", 
           RowBox[{"\[Gamma]2", "->", "2.044"}]}], "}"}], ",", 
         "\[IndentingNewLine]", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{"\[Eta]", "->", "11.3"}], ",", 
           RowBox[{"A", "->", "1.0000"}], ",", "  ", 
           RowBox[{"\[Gamma]0", "->", "0.9500"}], ",", 
           RowBox[{"\[Gamma]1", "->", "0.0000"}], ",", 
           RowBox[{"\[Gamma]2", "->", "2.044"}]}], "}"}], ",", 
         "\[IndentingNewLine]", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{"\[Eta]", "->", "10.8"}], ",", 
           RowBox[{"A", "->", "0.8918"}], ",", 
           RowBox[{"\[Gamma]0", "->", "0.9743"}], ",", 
           RowBox[{"\[Gamma]1", "->", "0.1586"}], ",", 
           RowBox[{"\[Gamma]2", "->", "0.1586"}]}], "}"}]}], 
        "\[IndentingNewLine]", "}"}], ",", "prec"}], "]"}]}], ";", 
    "\[IndentingNewLine]", 
    RowBox[{"rule", "=", 
     RowBox[{"rules", "[", 
      RowBox[{"[", "1", "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
    "\[IndentingNewLine]", 
    RowBox[{"f", "=", 
     RowBox[{"Uc", " ", 
      RowBox[{"Sum", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"(", 
          RowBox[{
           RowBox[{
            FractionBox[
             RowBox[{"\[ScriptCapitalN]", " ", "\[Alpha]"}], 
             RowBox[{"\[ScriptK]", "[", "0", "]"}]], " ", 
            RowBox[{"Sum", "[", 
             RowBox[{
              RowBox[{
               RowBox[{"Binomial", "[", 
                RowBox[{"n", ",", "i"}], "]"}], 
               RowBox[{"(", 
                RowBox[{
                 RowBox[{"D", "[", 
                  RowBox[{
                   RowBox[{"\[ScriptK]", "[", 
                    RowBox[{
                    FractionBox[
                    RowBox[{"2", 
                    RowBox[{"\[ScriptK]", "[", "0", "]"}]}], 
                    RowBox[{
                    "\[ScriptCapitalN]", " ", "\[Alpha]", " ", "Uc"}]], 
                    "\[ScriptR]"}], "]"}], ",", 
                   RowBox[{"{", 
                    RowBox[{"\[ScriptR]", ",", "i"}], "}"}]}], "]"}], "/.", 
                 RowBox[{"{", 
                  RowBox[{"\[ScriptR]", "->", "0"}], "}"}]}], ")"}]}], ",", 
              RowBox[{"{", 
               RowBox[{"i", ",", "0", ",", "n"}], "}"}]}], "]"}]}], "-", 
           "n"}], ")"}], 
         FractionBox[
          SuperscriptBox[
           RowBox[{"(", 
            RowBox[{
             FractionBox[
              RowBox[{"\[ScriptCapitalN]", " ", "\[Alpha]"}], 
              RowBox[{"2", 
               RowBox[{"\[ScriptK]", "[", "0", "]"}]}]], " ", "Uc", " ", 
             "r"}], ")"}], 
           RowBox[{"n", "-", "1"}]], 
          RowBox[{"n", "!"}]]}], ",", 
        RowBox[{"{", 
         RowBox[{"n", ",", "0", ",", 
          RowBox[{"\[ScriptCapitalN]", "-", "1"}]}], "}"}]}], "]"}]}]}], ";", 
    "\[IndentingNewLine]", 
    RowBox[{"g", "=", 
     RowBox[{
      RowBox[{
       RowBox[{"-", 
        FractionBox["2", "r"]}], 
       RowBox[{"\[ScriptK]", "[", "r", "]"}]}], "+", 
      RowBox[{
       RowBox[{"Exp", "[", 
        RowBox[{
         RowBox[{"-", 
          FractionBox[
           RowBox[{"\[ScriptCapitalN]", " ", "\[Alpha]"}], 
           RowBox[{"2", 
            RowBox[{"\[ScriptK]", "[", "0", "]"}]}]]}], " ", "Uc", " ", "r"}],
         "]"}], "f"}]}]}], ";", "\[IndentingNewLine]", "\[IndentingNewLine]", 
    RowBox[{"s", "=", 
     RowBox[{"Collect", "[", 
      RowBox[{
       RowBox[{"Series", "[", 
