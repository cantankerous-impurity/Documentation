Cell[BoxData[
 RowBox[{"Block", "[", 
  RowBox[{
   RowBox[{"{", "\[IndentingNewLine]", 
    RowBox[{
    "prec", ",", "\[CapitalDelta]", ",", "\[IndentingNewLine]", 
     "\[ScriptCapitalN]", ",", "Uc", ",", "\[IndentingNewLine]", "\[ScriptK]",
      ",", "rules", ",", "rule", ",", "n", ",", "\[IndentingNewLine]", 
     "\[Alpha]", ",", "\[IndentingNewLine]", "f", ",", "g", ",", 
     "\[IndentingNewLine]", "s", ",", "eqn", ",", "soln", ",", 
     "\[IndentingNewLine]", "plt"}], "\[IndentingNewLine]", "}"}], ",", 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"\[ScriptCapitalN]", "=", "3"}], ";", "\[IndentingNewLine]", 
    "\[IndentingNewLine]", 
    RowBox[{"f", "=", 
     RowBox[{"Uc", " ", 
      RowBox[{"Sum", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"(", 
          RowBox[{
           RowBox[{
            FractionBox[
             RowBox[{"\[ScriptCapitalN]", " ", "\[Alpha]"}], 
             RowBox[{"\[ScriptK]", "[", "0", "]"}]], " ", 
            RowBox[{"Sum", "[", 
             RowBox[{
              RowBox[{
               RowBox[{"Binomial", "[", 
                RowBox[{"n", ",", "i"}], "]"}], 
               RowBox[{"(", 
                RowBox[{
                 RowBox[{"D", "[", 
                  RowBox[{
                   RowBox[{"\[ScriptK]", "[", 
                    RowBox[{
                    FractionBox[
                    RowBox[{"2", 
                    RowBox[{"\[ScriptK]", "[", "0", "]"}]}], 
                    RowBox[{
                    "\[ScriptCapitalN]", " ", "\[Alpha]", " ", "Uc"}]], 
                    "\[ScriptR]"}], "]"}], ",", 
                   RowBox[{"{", 
                    RowBox[{"\[ScriptR]", ",", "i"}], "}"}]}], "]"}], "/.", 
                 RowBox[{"{", 
                  RowBox[{"\[ScriptR]", "->", "0"}], "}"}]}], ")"}]}], ",", 
              RowBox[{"{", 
               RowBox[{"i", ",", "0", ",", "n"}], "}"}]}], "]"}]}], "-", 
           "n"}], ")"}], 
         FractionBox[
          SuperscriptBox[
           RowBox[{"(", 
            RowBox[{
             FractionBox[
              RowBox[{"\[ScriptCapitalN]", " ", "\[Alpha]"}], 
              RowBox[{"2", 
               RowBox[{"\[ScriptK]", "[", "0", "]"}]}]], " ", "Uc", " ", 
             "r"}], ")"}], 
           RowBox[{"n", "-", "1"}]], 
          RowBox[{"n", "!"}]]}], ",", 
        RowBox[{"{", 
         RowBox[{"n", ",", "0", ",", 
          RowBox[{"\[ScriptCapitalN]", "-", "1"}]}], "}"}]}], "]"}]}]}], ";", 
    "\[IndentingNewLine]", 
    RowBox[{"g", "=", 
     RowBox[{
      RowBox[{
       RowBox[{"-", 
        FractionBox["2", "r"]}], 
       RowBox[{"\[ScriptK]", "[", "r", "]"}]}], "+", 
      RowBox[{
       RowBox[{"Exp", "[", 
        RowBox[{
         RowBox[{"-", 
          FractionBox[
           RowBox[{"\[ScriptCapitalN]", " ", "\[Alpha]"}], 
           RowBox[{"2", 
            RowBox[{"\[ScriptK]", "[", "0", "]"}]}]]}], " ", "Uc", " ", "r"}],
         "]"}], "f"}]}]}], ";", "\[IndentingNewLine]", "\[IndentingNewLine]", 
    RowBox[{"s", "=", 
     RowBox[{"Collect", "[", 
      RowBox[{
       RowBox[{"Series", "[", 
        RowBox[{"g", ",", 
         RowBox[{"{", 
          RowBox[{"r", ",", "0", ",", "\[ScriptCapitalN]"}], "}"}]}], "]"}], 
       ",", "r", ",", "Together"}], "]"}]}], ";", "\[IndentingNewLine]", 
    RowBox[{"eqn", "=", 
     RowBox[{"Assuming", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{"Uc", ">", "0"}], ",", 
         RowBox[{
          RowBox[{"\[ScriptK]", "[", "0", "]"}], ">", "0"}], ",", 
         RowBox[{"A", ">", "0"}], ",", 
         RowBox[{"\[Eta]", ">", "1"}]}], "}"}], ",", "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{
         RowBox[{"(", 
          RowBox[{
           RowBox[{"D", "[", 
            RowBox[{"s", ",", 
             RowBox[{"{", 
              RowBox[{"r", ",", 
               RowBox[{"\[ScriptCapitalN]", "-", "1"}]}], "}"}]}], "]"}], "/.", 
           RowBox[{"r", "->", "0"}]}], ")"}], "==", "0"}], "//", 
        "FullSimplify"}]}], "\[IndentingNewLine]", "]"}]}], ";", 
    "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"\[ScriptK]", "[", "r_", "]"}], "=", 
     RowBox[{"1", "+", 
      RowBox[{"A", " ", "\[Eta]", " ", 
       RowBox[{"Exp", "[", 
        RowBox[{
         RowBox[{"-", "\[Gamma]0"}], " ", "r"}], "]"}]}], "+", 
      RowBox[{
       RowBox[{"(", 
        RowBox[{"1", "-", "A"}], ")"}], "\[Eta]", " ", 
       RowBox[{"Exp", "[", 
        RowBox[{
         RowBox[{"-", "\[Gamma]1"}], " ", "r"}], "]"}]}], "-", 
      RowBox[{"Exp", "[", 
       RowBox[{
        RowBox[{"-", "\[Gamma]2"}], " ", "r"}], "]"}]}]}], ";", 
    "\[IndentingNewLine]", "\[IndentingNewLine]", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"Collect", "[", 
      RowBox[{"g", ",", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"Exp", "[", "_", "]"}], ",", "r"}], "}"}], ",", 
       "FullSimplify"}], "]"}], "//", "Print"}], ";", "\[IndentingNewLine]", 
    RowBox[{"Assuming", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
        RowBox[{"\[Alpha]", ">", "0"}], ",", 
        RowBox[{"Uc", ">", "0"}]}], "}"}], ",", 
      RowBox[{"Collect", "[", 
       RowBox[{"eqn", ",", "\[Alpha]", ",", 
        RowBox[{
         RowBox[{"Expand", "[", 
          RowBox[{"FullSimplify", "[", "#", "]"}], "]"}], "&"}]}], "]"}]}], 
     "]"}]}]}], "\[IndentingNewLine]", "\[IndentingNewLine]", "]"}]], "Input",
