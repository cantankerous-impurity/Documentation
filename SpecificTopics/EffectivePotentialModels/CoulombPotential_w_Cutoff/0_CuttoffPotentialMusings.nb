 RowBox[{
  RowBox[{"prec", "=", "240"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"f", "[", 
    RowBox[{"\[ScriptCapitalN]_", ",", "\[ScriptCapitalB]_"}], "]"}], ":=", 
   RowBox[{
    RowBox[{
     RowBox[{"(", 
      RowBox[{"1", "-", 
       FractionBox["r", "2"]}], ")"}], 
     RowBox[{"(", 
      RowBox[{"Sum", "[", 
       RowBox[{
        FractionBox[
         SuperscriptBox[
          RowBox[{"(", 
           RowBox[{"\[ScriptCapitalB]", " ", "r"}], ")"}], 
          RowBox[{"2", "n"}]], 
         RowBox[{"n", "!"}]], ",", 
        RowBox[{"{", 
         RowBox[{"n", ",", "0", ",", 
          RowBox[{"\[ScriptCapitalN]", "-", "1"}]}], "}"}]}], "]"}], ")"}]}], 
    "+", 
    FractionBox[
     SuperscriptBox[
      RowBox[{"(", 
       RowBox[{"\[ScriptCapitalB]", " ", "r"}], ")"}], 
      RowBox[{"2", "\[ScriptCapitalN]"}]], 
     RowBox[{"\[ScriptCapitalN]", "!"}]]}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"g", "[", 
