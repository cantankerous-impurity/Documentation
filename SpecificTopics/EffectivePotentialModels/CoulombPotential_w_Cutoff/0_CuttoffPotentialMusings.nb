Cell[BoxData[{
 RowBox[{
  RowBox[{"Clear", "[", 
   RowBox[{"f", ",", "g"}], "]"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"f", "[", 
   RowBox[{"\[ScriptCapitalN]_", ",", "\[Alpha]_"}], "]"}], ":=", 
  RowBox[{
   FractionBox["1", 
    RowBox[{"2", "\[Alpha]"}]], 
   RowBox[{"Sum", "[", 
    RowBox[{
     RowBox[{
      FractionBox[
       SuperscriptBox[
        RowBox[{"(", 
         RowBox[{"\[Alpha]", " ", "r"}], ")"}], "n"], 
       RowBox[{"n", "!"}]], 
      RowBox[{"(", 
