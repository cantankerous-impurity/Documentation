    RowBox[{"n", "-", "1"}], "]"}]], "//", 
  "FullSimplify"}], "\[IndentingNewLine]", 
 RowBox[{"Limit", "[", 
  RowBox[{
   RowBox[{
    RowBox[{
     RowBox[{"(", 
