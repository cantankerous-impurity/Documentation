Cell[BoxData[{
 RowBox[{
  RowBox[{"Clear", "[", "Ci", "]"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"Ci", "[", "\[ScriptCapitalN]_", "]"}], ":=", 
  FractionBox[
   SuperscriptBox[
    RowBox[{"(", 
     RowBox[{"\[ScriptCapitalB]", " ", "r"}], ")"}], 
    RowBox[{"2", "\[ScriptCapitalN]"}]], 
   RowBox[{"\[ScriptCapitalN]", "!"}]]}], "\[IndentingNewLine]", 
 RowBox[{
  FractionBox[
   RowBox[{"Ci", "[", "n", "]"}], 
   RowBox[{"Ci", "[", 
    RowBox[{"n", "-", "1"}], "]"}]], "//", 
  "FullSimplify"}], "\[IndentingNewLine]", 
 RowBox[{"Limit", "[", 
  RowBox[{
   RowBox[{
    RowBox[{
     RowBox[{"(", 
      FractionBox[
       RowBox[{"Ci", "[", "n", "]"}], 
       RowBox[{"Ci", "[", 
        RowBox[{"n", "-", "1"}], "]"}]], ")"}], "/.", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"\[ScriptCapitalB]", "->", 
        RowBox[{
         FractionBox[
          SqrtBox["n"], "2"], "+", "\[Delta]"}]}], ",", 
       RowBox[{"r", "->", "2"}]}], "}"}]}], "//", "FullSimplify"}], ",", 
   RowBox[{"n", "->", "\[Infinity]"}]}], "]"}]}], "Input",
