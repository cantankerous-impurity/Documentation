     RowBox[{"{", 
      RowBox[{
       RowBox[{"\[Alpha]", "->", 
        RowBox[{
         FractionBox["n", "2"], "+", "\[Delta]"}]}], ",", 
       RowBox[{"r", "->", "2"}]}], "}"}]}], "//", "FullSimplify"}], ",", 
