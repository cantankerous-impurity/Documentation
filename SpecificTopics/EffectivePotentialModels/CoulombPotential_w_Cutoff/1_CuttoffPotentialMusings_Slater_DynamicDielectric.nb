              RowBox[{"x", "[", 
               RowBox[{"[", 
                RowBox[{"n", ",", "1"}], "]"}], "]"}], "[", 
              RowBox[{"[", "2", "]"}], "]"}], ",", 
             RowBox[{"{", 
              RowBox[{"n", ",", "1", ",", 
               RowBox[{"Length", "[", "x", "]"}]}], "}"}]}], "]"}]}], "]"}], "//",
          "Chop"}], ",", "Positive"}], "]"}], "//", "Max"}]}], ";", 
    "\[IndentingNewLine]", "\[IndentingNewLine]", 
    RowBox[{"Off", "[", 
