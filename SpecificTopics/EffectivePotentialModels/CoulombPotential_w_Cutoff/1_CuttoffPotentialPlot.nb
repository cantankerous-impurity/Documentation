Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Block", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", ",", "U0", ",", "prec"}], "}"}], ",", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"g", "[", 
      RowBox[{"r_", ",", "\[ScriptCapitalN]_", ",", "\[Alpha]_"}], "]"}], ":=", 
     RowBox[{
      RowBox[{"-", 
       FractionBox["2", "r"]}], 
      RowBox[{"(", 
       RowBox[{"1", "-", 
        RowBox[{
         FractionBox[
          RowBox[{"Exp", "[", 
           RowBox[{
            RowBox[{"-", "\[Alpha]"}], " ", "r"}], "]"}], 
          RowBox[{"2", "\[Alpha]"}]], 
         RowBox[{"Sum", "[", 
          RowBox[{
           RowBox[{
            FractionBox[
             SuperscriptBox[
              RowBox[{"(", 
               RowBox[{"\[Alpha]", " ", "r"}], ")"}], "n"], 
             RowBox[{"n", "!"}]], 
            RowBox[{"(", 
             RowBox[{
              RowBox[{"2", "\[Alpha]"}], "-", "n"}], ")"}]}], ",", 
           RowBox[{"{", 
            RowBox[{"n", ",", "0", ",", "\[ScriptCapitalN]"}], "}"}]}], 
          "]"}]}]}], ")"}]}]}], ";", "\[IndentingNewLine]", 
    RowBox[{"U0", "=", "3"}], ";", 
    RowBox[{"prec", "=", "240"}], ";", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"plt", "[", "xp_", "]"}], ":=", 
     RowBox[{"Plot", "[", "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{"Style", "[", 
          RowBox[{
           RowBox[{"-", "U0"}], ",", "DotDashed"}], "]"}], ",", 
         RowBox[{"-", 
          FractionBox["2", "r"]}], ",", "xp"}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"r", ",", "0", ",", "10"}], "}"}], ",", "\[IndentingNewLine]", 
       RowBox[{"PlotRange", "->", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{
           RowBox[{"-", "1.2"}], "*", "U0"}], ",", "0.05"}], "}"}]}], ",", 
       "\[IndentingNewLine]", 
       RowBox[{"WorkingPrecision", "\[Rule]", "prec"}], ",", 
       RowBox[{"PerformanceGoal", "\[Rule]", "\"\<Quality\>\""}], ",", 
       RowBox[{"ImageSize", "\[Rule]", "Large"}]}], "\[IndentingNewLine]", 
      "]"}]}], ";", "\[IndentingNewLine]", 
    RowBox[{"Off", "[", 
     RowBox[{"General", "::", "munfl"}], "]"}], ";", "\[IndentingNewLine]", 
    RowBox[{"Do", "[", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{
       RowBox[{"gexp", "=", 
        RowBox[{"U0", " ", 
         RowBox[{"g", "[", 
          RowBox[{
           RowBox[{"U0", " ", "r"}], ",", "\[ScriptCapitalN]", ",", 
           FractionBox["\[ScriptCapitalN]", "2"]}], "]"}]}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{"Labeled", "[", 
         RowBox[{
          RowBox[{"plt", "[", "gexp", "]"}], ",", 
          RowBox[{"{", 
           RowBox[{
            FractionBox["r", 
             SubscriptBox["r", "AU"]], ",", 
            "\"\<\!\(\*FractionBox[\(E\), SubscriptBox[\(E\), \(AU\)]]\)\>\"",
             ",", 
            RowBox[{"\"\<\[ScriptCapitalN] = \>\"", "<>", 
             RowBox[{"ToString", "[", "\[ScriptCapitalN]", "]"}]}]}], "}"}], 
          ",", 
          RowBox[{"{", 
           RowBox[{"Top", ",", "Left", ",", "Bottom"}], "}"}]}], "]"}], "//", 
        "Print"}], ";", "\[IndentingNewLine]", 
       RowBox[{"Print", "[", "]"}], ";"}], "\[IndentingNewLine]", ",", 
      RowBox[{"{", 
       RowBox[{"\[ScriptCapitalN]", ",", 
        RowBox[{"{", 
         RowBox[{
         "1", ",", "2", ",", "10", ",", "50", ",", "100", ",", "500", ",", 
          "1000"}], "}"}]}], "}"}]}], "\[IndentingNewLine]", "]"}], ";", 
    "\[IndentingNewLine]", 
    RowBox[{"On", "[", 
     RowBox[{"General", "::", "munfl"}], "]"}], ";"}]}], 
  "\[IndentingNewLine]", "]"}]], "Input",
 CellChangeTimes->{{3.8636080509408712`*^9, 3.863608117800872*^9}, {
