   RowBox[{
    RowBox[{"prec", "=", "240"}], ";", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"g", "[", 
      RowBox[{"\[ScriptCapitalN]_", ",", "\[Alpha]_"}], "]"}], ":=", 
     RowBox[{
      RowBox[{"-", 
       FractionBox["2", "r"]}], "+", 
      RowBox[{
       RowBox[{"Exp", "[", 
        RowBox[{
         RowBox[{"-", "\[Alpha]"}], " ", "r"}], "]"}], 
       RowBox[{"Sum", "[", 
        RowBox[{
         RowBox[{
          FractionBox[
           SuperscriptBox[
            RowBox[{"(", 
             RowBox[{"\[Alpha]", " ", "r"}], ")"}], 
            RowBox[{"n", "-", "1"}]], 
           RowBox[{"n", "!"}]], 
          RowBox[{"(", 
           RowBox[{
            RowBox[{"2", "\[Alpha]"}], "-", "n"}], ")"}]}], ",", 
         RowBox[{"{", 
          RowBox[{"n", ",", "0", ",", "\[ScriptCapitalN]"}], "}"}]}], 
        "]"}]}]}]}], ";", "\[IndentingNewLine]", 
