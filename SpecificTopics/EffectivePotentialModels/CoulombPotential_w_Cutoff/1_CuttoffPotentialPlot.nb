Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Block", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"prec", ",", "f", ",", "g"}], "}"}], ",", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"prec", "=", "240"}], ";", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"f", "[", 
      RowBox[{"\[ScriptCapitalN]_", ",", "\[ScriptCapitalB]_"}], "]"}], ":=", 
     RowBox[{
      RowBox[{
       RowBox[{"(", 
        RowBox[{"1", "-", 
         FractionBox["r", "2"]}], ")"}], 
       RowBox[{"(", 
        RowBox[{"Sum", "[", 
         RowBox[{
          FractionBox[
           SuperscriptBox[
            RowBox[{"(", 
             RowBox[{"\[ScriptCapitalB]", " ", "r"}], ")"}], 
            RowBox[{"2", "n"}]], 
           RowBox[{"n", "!"}]], ",", 
          RowBox[{"{", 
           RowBox[{"n", ",", "0", ",", 
            RowBox[{"\[ScriptCapitalN]", "-", "1"}]}], "}"}]}], "]"}], 
        ")"}]}], "+", 
      FractionBox[
       SuperscriptBox[
        RowBox[{"(", 
         RowBox[{"\[ScriptCapitalB]", " ", "r"}], ")"}], 
        RowBox[{"2", "\[ScriptCapitalN]"}]], 
       RowBox[{"\[ScriptCapitalN]", "!"}]]}]}], ";", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"g", "[", 
      RowBox[{"\[ScriptCapitalN]_", ",", "\[ScriptCapitalB]_"}], "]"}], ":=", 
     RowBox[{
      RowBox[{"-", 
       FractionBox["2", "r"]}], 
      RowBox[{"(", 
       RowBox[{"1", "-", 
        RowBox[{
         RowBox[{"Exp", "[", 
          RowBox[{"-", 
           SuperscriptBox[
            RowBox[{"(", 
             RowBox[{"\[ScriptCapitalB]", " ", "r"}], ")"}], "2"]}], "]"}], 
         RowBox[{"f", "[", 
          RowBox[{"\[ScriptCapitalN]", ",", "\[ScriptCapitalB]"}], "]"}]}]}], 
       ")"}]}]}], ";", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"plt", "[", "xp_", "]"}], ":=", 
     RowBox[{"Plot", "[", "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{"Style", "[", 
          RowBox[{
           RowBox[{"-", "1"}], ",", "DotDashed"}], "]"}], ",", 
         RowBox[{"-", 
          FractionBox["2", "r"]}], ",", "xp"}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"r", ",", "0.1", ",", "10"}], "}"}], ",", 
       "\[IndentingNewLine]", 
       RowBox[{"PlotRange", "->", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"-", "1.2"}], ",", "0.05"}], "}"}]}], ",", 
       "\[IndentingNewLine]", 
       RowBox[{"WorkingPrecision", "\[Rule]", "prec"}], ",", 
       RowBox[{"PerformanceGoal", "\[Rule]", "\"\<Quality\>\""}], ",", 
       RowBox[{"ImageSize", "\[Rule]", "Large"}]}], "\[IndentingNewLine]", 
      "]"}]}], ";", "\[IndentingNewLine]", 
    RowBox[{"Off", "[", 
     RowBox[{"General", "::", "munfl"}], "]"}], ";", "\[IndentingNewLine]", 
    RowBox[{"Do", "[", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{
       RowBox[{"gexp", "=", 
        RowBox[{"SetPrecision", "[", 
         RowBox[{
          RowBox[{"g", "[", 
           RowBox[{"\[ScriptCapitalN]", ",", 
            FractionBox[
             SqrtBox["\[ScriptCapitalN]"], "2"]}], "]"}], ",", "prec"}], 
         "]"}]}], ";", "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{"Labeled", "[", 
         RowBox[{
          RowBox[{"plt", "[", "gexp", "]"}], ",", 
          RowBox[{"{", 
           RowBox[{
            FractionBox["r", 
             RowBox[{"u", " ", 
              SubscriptBox["r", "AU"]}]], ",", 
            "\"\<\!\(\*FractionBox[\(E\), \(u\\\ \*SubscriptBox[\(E\), \
\(AU\)]\)]\)\>\"", ",", 
            RowBox[{"\"\<\[ScriptCapitalN] = \>\"", "<>", 
             RowBox[{"ToString", "[", "\[ScriptCapitalN]", "]"}]}]}], "}"}], 
          ",", 
          RowBox[{"{", 
           RowBox[{"Top", ",", "Left", ",", "Bottom"}], "}"}]}], "]"}], "//", 
        "Print"}], ";", "\[IndentingNewLine]", 
       RowBox[{"Print", "[", "]"}], ";"}], "\[IndentingNewLine]", ",", 
      RowBox[{"{", 
       RowBox[{"\[ScriptCapitalN]", ",", 
        RowBox[{"{", 
         RowBox[{
         "1", ",", "2", ",", "10", ",", "50", ",", "100", ",", "500", ",", 
          "1000"}], "}"}]}], "}"}]}], "\[IndentingNewLine]", "]"}], ";", 
    "\[IndentingNewLine]", 
    RowBox[{"On", "[", 
     RowBox[{"General", "::", "munfl"}], "]"}], ";"}]}], 
  "\[IndentingNewLine]", "]"}]], "Input",
