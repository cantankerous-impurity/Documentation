           RowBox[{
            RowBox[{"-", 
             RowBox[{"(", 
              FractionBox[
               RowBox[{"j", "-", "3"}], 
               RowBox[{"j", "-", "2"}]], ")"}]}], 
            RowBox[{"HypergeometricFunction", "[", 
             RowBox[{"z", ",", 
              RowBox[{"j", "-", "4"}]}], "]"}]}], "+", 
           RowBox[{
            RowBox[{"(", 
             FractionBox[
              RowBox[{
               RowBox[{"2", "j"}], "-", "5", "+", 
               RowBox[{"2", 
                SuperscriptBox["z", "2"]}]}], 
              RowBox[{"j", "-", "2"}]], ")"}], 
            RowBox[{"HypergeometricFunction", "[", 
             RowBox[{"z", ",", 
              RowBox[{"j", "-", "2"}]}], "]"}]}]}], "]"}], ";"}]}], "]"}], 
      ";", "\n", "\n", 
      RowBox[{"zabs", "=", 
       RowBox[{"Abs", "[", "z", "]"}]}], ";", "\n", 
      RowBox[{"mindex", "=", 
       RowBox[{"Max", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"Ceiling", "[", 
           RowBox[{
            SuperscriptBox["zabs", "2"], "-", "j", "+", 
            FractionBox["3", "2"]}], "]"}], "-", "1"}], ",", "1"}], "]"}]}], 
      ";", "\n", "\n", "\n", 
      RowBox[{"digits", "=", 
