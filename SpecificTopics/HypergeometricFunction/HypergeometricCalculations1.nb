Cell[BoxData[
 RowBox[{
  RowBox[{"AsymptoticForm", "[", 
   RowBox[{"z_", ",", "j_"}], "]"}], ":=", 
  RowBox[{"Block", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
     "prec", ",", "num", ",", "del", ",", "k", ",", "part1", ",", "old", ",", 
      "new", ",", "mult", ",", "sum"}], "}"}], ",", "\n", 
    RowBox[{
     RowBox[{"prec", "=", "MachinePrecision"}], ";", "\[IndentingNewLine]", 
     "\n", 
     RowBox[{"del", "=", 
      RowBox[{"Mod", "[", 
       RowBox[{
        RowBox[{"j", "+", "1"}], ",", "2"}], "]"}]}], ";", "\n", 
     RowBox[{"num", "=", 
      RowBox[{"Floor", "[", 
       FractionBox[
        RowBox[{"j", "+", "1"}], "2"], "]"}]}], ";", "\n", "\n", 
     RowBox[{"If", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"Sign", "[", 
         RowBox[{"Re", "[", "z", "]"}], "]"}], "\[Equal]", 
        RowBox[{"-", "1"}]}], ",", "\n", 
       RowBox[{
        RowBox[{"If", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"Abs", "[", "z", "]"}], ">", 
           FractionBox["1", "2"]}], ",", "\n", "\n", 
          RowBox[{"(*", " ", 
           RowBox[{
            RowBox[{"Abs", "[", 
             RowBox[{"2", "z"}], "]"}], ">", "1"}], " ", "*)"}], "\n", "\n", 
          RowBox[{
           RowBox[{"k", "=", "0"}], ";", "\n", 
           RowBox[{"new", "=", 
            RowBox[{"2", 
             RowBox[{"(", 
              FractionBox[
               SqrtBox["\[Pi]"], 
               RowBox[{"Gamma", "[", 
                FractionBox["j", "2"], "]"}]], ")"}], 
             SuperscriptBox["\[ExponentialE]", 
              SuperscriptBox["z", "2"]], 
             SuperscriptBox[
              RowBox[{"(", 
               RowBox[{"-", "z"}], ")"}], 
              RowBox[{"j", "-", "1"}]]}]}], ";", "\n", 
           RowBox[{"sum", "=", "new"}], ";", "\n", "\n", 
           RowBox[{"While", "[", 
            RowBox[{
             RowBox[{
              RowBox[{"(", 
               RowBox[{
                RowBox[{"Abs", "[", "new", "]"}], ">", 
                SuperscriptBox["10", 
                 RowBox[{"-", "prec"}]]}], ")"}], "&&", 
              RowBox[{"(", 
               RowBox[{
                RowBox[{"Abs", "[", 
                 FractionBox["new", "sum"], "]"}], ">", 
                SuperscriptBox["10", 
                 RowBox[{"-", "prec"}]]}], ")"}], "&&", 
              RowBox[{"(", 
               RowBox[{"k", "<", 
                RowBox[{"num", "-", "1"}]}], ")"}]}], ",", "\n", 
             RowBox[{
              RowBox[{"k", "=", 
               RowBox[{"k", "+", "1"}]}], ";", "\n", "\n", 
              RowBox[{"old", "=", "new"}], ";", "\n", 
              RowBox[{"mult", "=", 
               FractionBox[
                RowBox[{
                 RowBox[{"(", 
                  RowBox[{
                   RowBox[{"2", "k"}], "-", "j"}], ")"}], " ", 
                 RowBox[{"(", 
                  RowBox[{
                   RowBox[{"2", "k"}], "-", "j", "-", "1"}], ")"}]}], 
                RowBox[{"k", " ", 
                 SuperscriptBox[
                  RowBox[{"(", 
                   RowBox[{"2", "z"}], ")"}], "2"]}]]}], ";", "\n", 
              RowBox[{"new", "=", 
               RowBox[{"mult", "*", "old"}]}], ";", "\n", 
              RowBox[{"sum", "=", 
               RowBox[{"sum", "+", "new"}]}], ";"}]}], "\[IndentingNewLine]", 
            "]"}], ";"}], "\n", "\n", ",", "\n", "\n", 
          RowBox[{"(*", " ", 
           RowBox[{
            RowBox[{"Abs", "[", 
             RowBox[{"2", "z"}], "]"}], "<", "1"}], " ", "*)"}], "\n", "\n", 
          "\n", 
          RowBox[{
           RowBox[{"k", "=", "0"}], ";", "\n", 
           RowBox[{"new", "=", 
            RowBox[{"2", 
             SuperscriptBox[
              RowBox[{"(", 
               RowBox[{"-", "1"}], ")"}], 
              RowBox[{"j", "-", "1"}]], 
             FractionBox[
              RowBox[{"Gamma", "[", 
               RowBox[{"num", " ", "+", " ", 
                FractionBox["del", "2"]}], "]"}], 
              RowBox[{"Gamma", "[", "num", "]"}]], 
             SuperscriptBox["\[ExponentialE]", 
              SuperscriptBox["z", "2"]], 
             SuperscriptBox[
              RowBox[{"(", 
               RowBox[{"2", "z"}], ")"}], "del"]}]}], ";", "\n", 
           RowBox[{"sum", "=", "new"}], ";", "\n", "\n", 
           RowBox[{"While", "[", 
            RowBox[{
             RowBox[{
              RowBox[{"(", 
               RowBox[{
                RowBox[{"Abs", "[", "new", "]"}], ">", 
                SuperscriptBox["10", 
                 RowBox[{"-", "prec"}]]}], ")"}], "&&", 
              RowBox[{"(", 
               RowBox[{
                RowBox[{"Abs", "[", 
                 FractionBox["new", "sum"], "]"}], ">", 
                SuperscriptBox["10", 
                 RowBox[{"-", "prec"}]]}], ")"}], "&&", 
              RowBox[{"(", 
               RowBox[{"k", "<", 
                RowBox[{"num", "-", "1"}]}], ")"}]}], ",", "\n", 
             RowBox[{
              RowBox[{"k", "=", 
               RowBox[{"k", "+", "1"}]}], ";", "\n", "\n", 
              RowBox[{"old", "=", "new"}], ";", "\n", 
              RowBox[{"mult", "=", 
               FractionBox[
                RowBox[{
                 RowBox[{"(", 
                  RowBox[{"num", "-", "k"}], ")"}], " ", 
                 SuperscriptBox[
                  RowBox[{"(", 
                   RowBox[{"2", "z"}], ")"}], "2"]}], 
                RowBox[{
                 RowBox[{"(", 
                  RowBox[{
                   RowBox[{"2", "k"}], "+", "del", "-", "1"}], ")"}], 
                 RowBox[{"(", 
                  RowBox[{
                   RowBox[{"2", "k"}], "+", "del"}], ")"}]}]]}], ";", "\n", 
              RowBox[{"new", "=", 
               RowBox[{"mult", "*", "old"}]}], ";", "\n", 
              RowBox[{"sum", "=", 
               RowBox[{"sum", "+", "new"}]}], ";"}]}], "\[IndentingNewLine]", 
            "]"}], ";"}]}], "\n", "\n", "\n", "\n", "]"}], ";", "\n", 
        RowBox[{"part1", "=", "sum"}], ";"}], "\n", ",", "\n", 
       RowBox[{
        RowBox[{"part1", "=", "0"}], ";"}]}], "\n", "]"}], ";", "\n", "\n", 
     "\n", 
     RowBox[{"sum", "=", 
      FractionBox[
       RowBox[{"2", 
        RowBox[{"Gamma", "[", "j", "]"}]}], 
       RowBox[{
        RowBox[{"Gamma", "[", 
         FractionBox["j", "2"], "]"}], 
        SuperscriptBox[
         RowBox[{"(", 
          RowBox[{"2", "z"}], ")"}], "j"]}]]}], ";", "\[IndentingNewLine]", 
     RowBox[{"k", "=", "1"}], ";", "\n", 
     RowBox[{"old", "=", 
      FractionBox[
       RowBox[{"2", 
        RowBox[{"Gamma", "[", "j", "]"}]}], 
       RowBox[{
        RowBox[{"Gamma", "[", 
         FractionBox["j", "2"], "]"}], 
        SuperscriptBox[
         RowBox[{"(", 
          RowBox[{"2", "z"}], ")"}], "j"]}]]}], ";", "\n", 
     RowBox[{"mult", "=", 
      RowBox[{"-", 
       FractionBox[
        RowBox[{
         RowBox[{"(", 
          RowBox[{
           RowBox[{"2", "k"}], "+", "j", "-", "2"}], ")"}], 
         RowBox[{"(", 
          RowBox[{
           RowBox[{"2", "k"}], "+", "j", "-", "1"}], ")"}]}], 
        RowBox[{"k", " ", 
         SuperscriptBox[
          RowBox[{"(", 
           RowBox[{"2", "z"}], ")"}], "2"]}]]}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"If", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"Abs", "[", "mult", "]"}], ">", "1.0"}], ",", 
       RowBox[{
        RowBox[{"Print", "[", 
         RowBox[{"\"\<Early return:  \>\"", ",", "k"}], "]"}], ";", " ", 
        RowBox[{"Return", "[", 
         RowBox[{"part1", "+", "old"}], "]"}], ";"}]}], "]"}], ";", "\n", 
     RowBox[{"new", "=", 
      RowBox[{"mult", "*", "old"}]}], ";", "\n", 
     RowBox[{"While", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"(", 
         RowBox[{
          RowBox[{"Abs", "[", "new", "]"}], ">", 
          SuperscriptBox["10", 
           RowBox[{"-", "prec"}]]}], ")"}], "&&", 
        RowBox[{"(", 
         RowBox[{
          RowBox[{"Abs", "[", 
           FractionBox["new", 
            RowBox[{"part1", "+", "sum"}]], "]"}], ">", 
          SuperscriptBox["10", 
           RowBox[{"-", "prec"}]]}], ")"}], "&&", 
        RowBox[{"(", 
         RowBox[{"k", "<", "200"}], ")"}]}], ",", "\n", 
       RowBox[{
        RowBox[{"sum", "=", 
         RowBox[{"sum", "+", "new"}]}], ";", "\n", 
        RowBox[{"k", "=", 
         RowBox[{"k", "+", "1"}]}], ";", "\n", 
        RowBox[{"old", "=", "new"}], ";", "\n", 
        RowBox[{"mult", "=", 
         RowBox[{"-", 
          FractionBox[
           RowBox[{
            RowBox[{"(", 
             RowBox[{
              RowBox[{"2", "k"}], "+", "j", "-", "2"}], ")"}], 
            RowBox[{"(", 
             RowBox[{
              RowBox[{"2", "k"}], "+", "j", "-", "1"}], ")"}]}], 
           RowBox[{"k", " ", 
            SuperscriptBox[
             RowBox[{"(", 
              RowBox[{"2", "z"}], ")"}], "2"]}]]}]}], ";", "\n", 
        RowBox[{"If", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"Abs", "[", "mult", "]"}], ">", "1.0"}], ",", 
          RowBox[{
           RowBox[{"Print", "[", 
            RowBox[{"\"\<Early return:  \>\"", ",", "k"}], "]"}], ";", " ", 
           RowBox[{"Return", "[", 
            RowBox[{"part1", "+", "sum"}], "]"}], ";"}]}], "]"}], ";", "\n", 
        RowBox[{"new", "=", 
         RowBox[{"mult", "*", "old"}]}], ";"}]}], "\[IndentingNewLine]", 
      "]"}], ";", "\n", 
     RowBox[{"sum", "=", 
      RowBox[{"sum", "+", "new"}]}], ";", "\n", 
     RowBox[{"Print", "[", 
      RowBox[{"k", "+", "1"}], "]"}], ";", "\[IndentingNewLine]", 
     RowBox[{"Return", "[", 
      RowBox[{"part1", "+", "sum"}], "]"}], ";"}]}], "\[IndentingNewLine]", 
   "]"}]}]], "Code",
