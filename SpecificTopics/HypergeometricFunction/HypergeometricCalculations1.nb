             RowBox[{"j", "+", 
              RowBox[{"2", "mindex"}], "-", "1"}]}], "]"}]}], "-", 
          RowBox[{
           FractionBox["1", "2"], 
           RowBox[{"Log", "[", 
            RowBox[{"10", ",", "mindex"}], "]"}]}], "-", 
          RowBox[{"mindex", 
           RowBox[{"(", 
            RowBox[{
             RowBox[{"2", " ", 
              RowBox[{"Log", "[", 
               RowBox[{"10", ",", "2"}], "]"}]}], "+", 
             RowBox[{"Log", "[", 
              RowBox[{"10", ",", "\[ExponentialE]"}], "]"}], "+", 
             RowBox[{"2", " ", 
              RowBox[{"Log", "[", 
               RowBox[{"10", ",", "zabs"}], "]"}]}], "+", 
             RowBox[{"Log", "[", 
              RowBox[{"10", ",", "mindex"}], "]"}]}], ")"}]}]}], ",", "\n", 
         RowBox[{
          RowBox[{"-", 
           RowBox[{
            FractionBox["1", "2"], 
            RowBox[{"Log", "[", 
             RowBox[{"10", ",", "2"}], "]"}]}]}], "-", 
          RowBox[{
           FractionBox["1", "2"], 
           RowBox[{"Log", "[", 
            RowBox[{"10", ",", "\[Pi]"}], "]"}]}], "+", 
          RowBox[{
           RowBox[{"(", 
            FractionBox[
             RowBox[{"1", "-", "j"}], "2"], ")"}], 
           RowBox[{"Log", "[", 
            RowBox[{"10", ",", 
             RowBox[{"j", "-", "2"}]}], "]"}]}], "+", 
          RowBox[{
           RowBox[{"(", 
            RowBox[{"-", 
             FractionBox["j", "2"]}], ")"}], " ", 
           RowBox[{"Log", "[", 
            RowBox[{"10", ",", 
             RowBox[{"j", "-", "1"}]}], "]"}]}], "+", 
          RowBox[{
