Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"BuchholzForm", "[", 
    RowBox[{"z_", ",", "j_"}], "]"}], ":=", 
   RowBox[{"Block", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
      "prec", ",", "\n", "q", ",", "qabs", ",", "zabs", ",", 
       "\[IndentingNewLine]", "k", ",", "jArray", ",", "jN", ",", "c0", ",", 
       "\n", "\[IndentingNewLine]", "\[Nu]", ",", "\[Nu]1", ",", "\[Nu]Max", 
       ",", "\n", "\n", "\[IndentingNewLine]", "n0", ",", "n1", ",", "n2", 
       ",", "\[IndentingNewLine]", "f0", ",", "f1", ",", "f2", ",", "\n", 
       "fA", ",", "fB", ",", "\n", "temp", ",", "\[IndentingNewLine]", "prev",
        ",", "now", ",", "new", ",", "newn", ",", "newd"}], "}"}], ",", "\n", 
     RowBox[{
      RowBox[{"prec", "=", "MachinePrecision"}], ";", "\n", 
      "\[IndentingNewLine]", 
      RowBox[{"q", "=", 
       RowBox[{
        RowBox[{"+", "\[ImaginaryI]"}], " ", "z", 
        SqrtBox[
         RowBox[{
          RowBox[{"2", " ", "j"}], "-", "1"}]]}]}], ";", "\n", 
      RowBox[{"qabs", "=", 
       RowBox[{"Abs", "[", "q", "]"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"zabs", "=", 
       RowBox[{"Abs", "[", "z", "]"}]}], ";", "\n", 
      RowBox[{"jN", "=", "10000"}], ";", "\[IndentingNewLine]", 
      RowBox[{"jArray", "=", 
       RowBox[{"ConstantArray", "[", 
        RowBox[{"0", ",", "jN"}], "]"}]}], ";", "\[IndentingNewLine]", 
      "\[IndentingNewLine]", "\n", 
      RowBox[{"(*", " ", 
       RowBox[{"This", " ", "is", " ", 
        RowBox[{"Newton", "'"}], "s", " ", "method", " ", "to", " ", "find", 
        " ", "the", " ", "value", " ", "of", " ", "n2", " ", "that", " ", 
        "makes", " ", "f", 
        RowBox[{"(", "n", ")"}], " ", "equal", " ", "to", " ", 
        SuperscriptBox["10", 
         RowBox[{"-", "error"}]]}], " ", "*)"}], "\n", 
      RowBox[{"(*", " ", 
       RowBox[{
        RowBox[{"f", 
         RowBox[{"(", "n", ")"}], " ", "counts", " ", "the", " ", 
         "approximate", " ", "order", " ", "of", " ", "magnitude", " ", "of", 
         " ", 
         RowBox[{
          RowBox[{"Abs", "[", 
           RowBox[{
            RowBox[{"Exp", "[", 
             FractionBox[
              SuperscriptBox["z", "2"], "2"], "]"}], 
            RowBox[{"(", 
             RowBox[{"jn", 
              RowBox[{
               RowBox[{"(", "q", ")"}], "/", 
               SuperscriptBox["q", "n"]}]}], ")"}], 
            SuperscriptBox["z", 
             RowBox[{
              RowBox[{"2", "n"}], "+", "1"}]]}], "]"}], " ", "~", " ", 
          RowBox[{"Abs", "[", 
           RowBox[{
            SuperscriptBox["\[ExponentialE]", 
             RowBox[{
              SuperscriptBox["z", "2"], "/", "2"}]], 
            RowBox[{"(", 
             RowBox[{
              SuperscriptBox["2", "n"], 
              SuperscriptBox["\[ExponentialE]", 
               RowBox[{"n", "+", "1"}]], 
              FractionBox[
               SuperscriptBox["n", 
                RowBox[{"n", "+", 
                 RowBox[{"1", "/", "2"}]}]], 
               SuperscriptBox[
                RowBox[{"(", 
                 RowBox[{
                  RowBox[{"2", "n"}], "+", "1"}], ")"}], 
                RowBox[{
                 RowBox[{"2", "n"}], "+", 
                 RowBox[{"3", "/", "2"}]}]]]}], ")"}], 
            SuperscriptBox["z", 
             RowBox[{
              RowBox[{"2", "n"}], "+", "1"}]]}], "]"}]}]}], " ", "\[Equal]", 
        " ", 
        RowBox[{
         RowBox[{"(", 
          RowBox[{
           SuperscriptBox["\[ExponentialE]", 
            RowBox[{"Re", "[", 
             RowBox[{
              FractionBox[
               SuperscriptBox["z", "2"], "2"], "+", "1"}], "]"}]], 
           RowBox[{"Abs", "[", "z", "]"}]}], ")"}], 
         SuperscriptBox[
          RowBox[{"(", 
           RowBox[{"2", 
            SuperscriptBox[
             RowBox[{"\[ExponentialE]Abs", "[", "z", "]"}], "2"]}], ")"}], 
          "n"], 
         FractionBox[
          SuperscriptBox["n", 
           RowBox[{"n", "+", 
            RowBox[{"1", "/", "2"}]}]], 
          SuperscriptBox[
           RowBox[{"(", 
            RowBox[{
             RowBox[{"2", "n"}], "+", "1"}], ")"}], 
           RowBox[{
            RowBox[{"2", "n"}], "+", 
            RowBox[{"3", "/", "2"}]}]]]}]}], " ", "*)"}], "\n", "\n", 
      RowBox[{"(*", " ", 
       RowBox[{
        RowBox[{
         RowBox[{"Use", " ", 
          RowBox[{"Newton", "'"}], "s", " ", "method", " ", "to", " ", 
          "solve", " ", 
          RowBox[{"(", 
           RowBox[{
            RowBox[{
             RowBox[{"Re", "[", 
              RowBox[{
               FractionBox[
                SuperscriptBox["z", "2"], "2"], "+", "1"}], "]"}], 
             RowBox[{"Log", "[", 
              RowBox[{"10", ",", "\[ExponentialE]"}], "]"}]}], "+", 
            RowBox[{"Log", "[", 
             RowBox[{"10", ",", "zabs"}], "]"}]}], ")"}]}], "+", 
         RowBox[{"n", 
          RowBox[{"(", 
           RowBox[{
            RowBox[{"Log", "[", 
             RowBox[{"10", ",", "2"}], "]"}], "+", 
            RowBox[{"Log", "[", 
             RowBox[{"10", ",", "\[ExponentialE]"}], "]"}], "+", 
            RowBox[{"2", 
             RowBox[{"Log", "[", 
              RowBox[{"10", ",", "zabs"}], "]"}]}]}], ")"}]}], "+", 
         RowBox[{
          RowBox[{"(", 
           RowBox[{"n", "+", 
            FractionBox["1", "2"]}], ")"}], 
          RowBox[{"Log", "[", 
           RowBox[{"10", ",", "n"}], "]"}]}], "-", 
         RowBox[{
          RowBox[{"(", 
           RowBox[{
            RowBox[{"2", "n"}], "+", 
            FractionBox["3", "2"]}], ")"}], 
          RowBox[{"Log", "[", 
           RowBox[{"10", ",", 
            RowBox[{
             RowBox[{"2", "n"}], "+", "1"}]}], "]"}]}]}], "\[Equal]", 
        RowBox[{"-", "error"}]}], " ", "*)"}], "\[IndentingNewLine]", 
      RowBox[{"(*", " ", 
       RowBox[{
       "Calculate", " ", "constant", " ", "factors", " ", "used", " ", "in", 
        " ", "later", " ", "equations"}], " ", "*)"}], "\n", 
      RowBox[{"fA", "=", 
       RowBox[{
        RowBox[{
         RowBox[{"Re", "[", 
          RowBox[{
           FractionBox[
            SuperscriptBox["z", "2"], "2"], "+", "1"}], "]"}], 
         RowBox[{"Log", "[", 
          RowBox[{"10", ",", "\[ExponentialE]"}], "]"}]}], "+", 
        RowBox[{"Log", "[", 
         RowBox[{"10", ",", "zabs"}], "]"}]}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"fB", "=", 
       RowBox[{
        RowBox[{"Log", "[", 
         RowBox[{"10", ",", "2"}], "]"}], "+", 
        RowBox[{"Log", "[", 
         RowBox[{"10", ",", "\[ExponentialE]"}], "]"}], "+", 
        RowBox[{"2", 
         RowBox[{"Log", "[", 
          RowBox[{"10", ",", "zabs"}], "]"}]}]}]}], ";", "\n", "\n", 
      "\[IndentingNewLine]", "\n", 
      RowBox[{"(*", " ", 
       RowBox[{
       "prec", " ", "tells", " ", "how", " ", "many", " ", "digits", " ", 
        "of", " ", "precision", " ", "this", " ", "code", " ", "is", " ", 
        "trying", " ", "to", " ", "achieve"}], " ", "*)"}], "\n", 
      RowBox[{"prec", "=", "MachinePrecision"}], ";", "\n", "\n", "\n", 
      RowBox[{"n0", "=", 
       RowBox[{"Ceiling", "[", 
        FractionBox[
         SuperscriptBox["zabs", "2"], "2"], "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"n1", "=", 
       RowBox[{"n0", "+", "5"}]}], ";", "\[IndentingNewLine]", "\n", 
      RowBox[{"f0", "=", 
       RowBox[{"fA", "+", 
        RowBox[{"n0", 
         RowBox[{"(", "fB", ")"}]}], "+", 
        RowBox[{
         RowBox[{"(", 
          RowBox[{"n0", "+", 
           FractionBox["1", "2"]}], ")"}], 
         RowBox[{"Log", "[", 
          RowBox[{"10", ",", "n0"}], "]"}]}], "-", 
        RowBox[{
         RowBox[{"(", 
          RowBox[{
           RowBox[{"2", "n0"}], "+", 
           FractionBox["3", "2"]}], ")"}], 
         RowBox[{"Log", "[", 
          RowBox[{"10", ",", 
           RowBox[{
            RowBox[{"2", "n0"}], "+", "1"}]}], "]"}]}], "+", "prec"}]}], ";", 
      "\n", 
      RowBox[{"f1", "=", 
       RowBox[{"fA", "+", 
        RowBox[{"n1", 
         RowBox[{"(", "fB", ")"}]}], "+", 
        RowBox[{
         RowBox[{"(", 
          RowBox[{"n1", "+", 
           FractionBox["1", "2"]}], ")"}], 
         RowBox[{"Log", "[", 
          RowBox[{"10", ",", "n1"}], "]"}]}], "-", 
        RowBox[{
         RowBox[{"(", 
          RowBox[{
           RowBox[{"2", "n1"}], "+", 
           FractionBox["3", "2"]}], ")"}], 
         RowBox[{"Log", "[", 
          RowBox[{"10", ",", 
           RowBox[{
            RowBox[{"2", "n1"}], "+", "1"}]}], "]"}]}], "+", "prec"}]}], ";", 
      "\n", "\n", "\[IndentingNewLine]", 
      RowBox[{"Do", "[", "\n", 
       RowBox[{
        RowBox[{
         RowBox[{"n2", "=", 
          RowBox[{"n1", "-", 
           FractionBox[
            RowBox[{"(", 
             RowBox[{"n1", "-", "n0"}], ")"}], 
            RowBox[{"1", "-", 
             FractionBox["f0", "f1"]}]]}]}], ";", "\n", 
         RowBox[{"n2", "=", 
          RowBox[{"Ceiling", "[", "n2", "]"}]}], ";", "\n", 
         RowBox[{"If", "[", 
          RowBox[{
           RowBox[{
            RowBox[{"Im", "[", "n2", "]"}], "\[NotEqual]", "0"}], ",", 
           RowBox[{
            RowBox[{
            "Print", "[", "\"\<n2 is complex something has gone wrong.\>\"", 
             "]"}], ";"}]}], "]"}], ";", "\n", 
         RowBox[{"f2", "=", 
          RowBox[{"fA", "+", 
           RowBox[{"n2", 
            RowBox[{"(", "fB", ")"}]}], "+", 
           RowBox[{
            RowBox[{"(", 
             RowBox[{"n2", "+", 
              FractionBox["1", "2"]}], ")"}], 
            RowBox[{"Log", "[", 
             RowBox[{"10", ",", "n2"}], "]"}]}], "-", 
           RowBox[{
            RowBox[{"(", 
             RowBox[{
              RowBox[{"2", "n2"}], "+", 
              FractionBox["3", "2"]}], ")"}], 
            RowBox[{"Log", "[", 
             RowBox[{"10", ",", 
              RowBox[{
               RowBox[{"2", "n2"}], "+", "1"}]}], "]"}]}], "+", "prec"}]}], 
         ";", "\[IndentingNewLine]", "\n", 
         RowBox[{"(*", " ", 
          RowBox[{
           RowBox[{
            RowBox[{
            "This", " ", "is", " ", "equivalent", " ", "to", " ", "n1"}], " ",
             "\[Equal]", " ", "n2"}], ",", " ", 
           RowBox[{"the", " ", "solution", " ", "has", " ", "converged"}], 
           ",", " ", 
           RowBox[{
            RowBox[{"you", "'"}], "re", " ", "done", " ", "with", " ", "the", 
            " ", 
            RowBox[{"loop", "."}]}]}], " ", "*)"}], "\[IndentingNewLine]", 
         RowBox[{"If", "[", 
          RowBox[{
           RowBox[{
            RowBox[{"Abs", "[", 
             RowBox[{"n2", "-", "n1"}], "]"}], " ", "<", " ", "1"}], ",", 
           RowBox[{"Break", "[", "]"}]}], "]"}], ";", "\[IndentingNewLine]", 
         "\[IndentingNewLine]", 
         RowBox[{"n0", "=", "n1"}], ";", "\[IndentingNewLine]", 
         RowBox[{"f0", "=", "f1"}], ";", "\[IndentingNewLine]", 
         RowBox[{"n1", "=", "n2"}], ";", "\[IndentingNewLine]", 
         RowBox[{"f1", "=", "f2"}], ";"}], "\[IndentingNewLine]", ",", 
        RowBox[{"{", 
         RowBox[{"i", ",", "1", ",", "20"}], "}"}]}], "]"}], ";", "\n", "\n", 
      RowBox[{"(*", " ", 
       RowBox[{
       "How", " ", "many", " ", "Bessel", " ", "functions", " ", "are", " ", 
        "needed", " ", "to", " ", "generate", " ", "the", " ", "summed", " ", 
        "result", " ", "to", " ", "within", " ", "machine", " ", 
        "precision"}], " ", "*)"}], "\n", 
      RowBox[{"\[Nu]1", " ", "=", " ", 
       RowBox[{"n2", "+", 
        RowBox[{"Ceiling", "[", 
         RowBox[{"16", 
          SqrtBox["n2"]}], "]"}]}]}], ";", "\n", "\n", 
      RowBox[{"If", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"\[Nu]1", "+", "1"}], ">", "jN"}], ",", 
        RowBox[{
         RowBox[{
         "Print", "[", 
          "\"\<Not enough possible scratch space to satisfy \[Nu]1, error is \
probably introduced!\>\"", "]"}], ";"}]}], "]"}], ";", "\[IndentingNewLine]", 
      RowBox[{"\[Nu]Max", "=", 
       RowBox[{"Min", "[", 
        RowBox[{
         RowBox[{"jN", "-", "1"}], ",", "\[Nu]1"}], "]"}]}], ";", 
